<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Codex Geographica — Complete Biblical & Apocryphal Interactive Atlas</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://d3js.org/d3.v7.min.js"></script>
  <script src="https://unpkg.com/topojson-client@3"></script>
  <style>
    :root {
      --bg-dark: #090d16;
      --panel-bg: #111827;
      --border-col: #1f2937;
      /* Okabe-Ito Colorblind-Safe Categorical Palette */
      --col-ot: #E69F00;         /* Orange — Old Testament */
      --col-nt-gospel: #56B4E9;  /* Sky Blue — Gospels & Jesus's Ministry */
      --col-nt-epistle: #009E73; /* Bluish Green — Acts & Epistles */
      --col-apoc: #CC79A7;       /* Reddish Purple — Apocrypha / Deuterocanon / Ethiopian / Egypt */
      --col-prophecy: #F0E442;   /* Yellow — Apocalyptic & Revelation */
    }
    body {
      background-color: var(--bg-dark);
      color: #e2e8f0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      overflow-x: hidden;
    }
    .custom-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scroll::-webkit-scrollbar-track { background: #0b1120; }
    .custom-scroll::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    .custom-scroll::-webkit-scrollbar-thumb:hover { background: #475569; }
    .map-surface {
      background: radial-gradient(circle at 50% 45%, #13203d 0%, #070b14 100%);
    }
    .kbd {
      background: #1e293b;
      border: 1px solid #475569;
      border-radius: 4px;
      padding: 1px 5px;
      font-size: 0.7rem;
      font-family: monospace;
    }
    .cvd-deuteranopia { filter: saturate(0.75) hue-rotate(-18deg); }
    .cvd-grayscale { filter: grayscale(100%); }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-teal-500 selection:text-slate-950">

  <!-- TOP NAVIGATION & WORKSPACE MODES -->
  <header class="border-b border-slate-800 bg-slate-900/95 backdrop-blur sticky top-0 z-40 px-4 py-2.5">
    <div class="max-w-[1840px] mx-auto flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-teal-500/15 border border-teal-400/40 flex items-center justify-center text-teal-300 font-bold text-lg shadow-inner">
          ⊕
        </div>
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h1 class="text-base sm:text-lg font-bold tracking-tight text-white">
              Codex Geographica
            </h1>
            <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-teal-950/90 text-teal-300 border border-teal-700/50">
              84 Books • 39 OT • 27 NT • 18 Apocrypha • 36-Step Atlas
            </span>
          </div>
          <p class="text-xs text-slate-400">
            Cumulative Interactive Space: Every Writer, Passage Breakdown, Canonical &amp; Apocryphal Journey
          </p>
        </div>
      </div>

      <!-- Primary Workspace Mode Tabs (JOURNEY / LIBRARY / LOOM / LINKS) -->
      <nav aria-label="Workspace views" class="flex items-center gap-1 bg-slate-950 p-1 rounded-lg border border-slate-800">
        <button data-workspace="journey" class="ws-tab px-3 py-1.5 rounded-md text-xs font-semibold transition bg-teal-600 text-white shadow">
          🗺️ JOURNEY
        </button>
        <button data-workspace="library" class="ws-tab px-3 py-1.5 rounded-md text-xs font-semibold transition text-slate-300 hover:text-white hover:bg-slate-800/70">
          📖 LIBRARY (84)
        </button>
        <button data-workspace="loom" class="ws-tab px-3 py-1.5 rounded-md text-xs font-semibold transition text-slate-300 hover:text-white hover:bg-slate-800/70">
          🧵 LOOM (Writers &amp; Canon)
        </button>
        <button data-workspace="links" class="ws-tab px-3 py-1.5 rounded-md text-xs font-semibold transition text-slate-300 hover:text-white hover:bg-slate-800/70">
          🔗 LINKS (Cross-Text)
        </button>
      </nav>

      <!-- Perceptual & Tradition Filters -->
      <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Tradition filters">
        <button data-tradition="ALL" class="trad-btn active px-2.5 py-1 rounded text-xs font-medium bg-slate-100 text-slate-900 transition">
          All (84)
        </button>
        <button data-tradition="OT" class="trad-btn px-2.5 py-1 rounded text-xs font-medium bg-slate-800/90 text-amber-300 border border-amber-500/40 hover:bg-slate-700 transition">
          ■ Old Testament (39)
        </button>
        <button data-tradition="NT_GOSPEL" class="trad-btn px-2.5 py-1 rounded text-xs font-medium bg-slate-800/90 text-sky-300 border border-sky-500/40 hover:bg-slate-700 transition">
          ● Gospels (4)
        </button>
        <button data-tradition="NT_EPISTLE" class="trad-btn px-2.5 py-1 rounded text-xs font-medium bg-slate-800/90 text-emerald-300 border border-emerald-500/40 hover:bg-slate-700 transition">
          ▲ Acts &amp; Epistles (22)
        </button>
        <button data-tradition="APOCRYPHA" class="trad-btn px-2.5 py-1 rounded text-xs font-medium bg-slate-800/90 text-pink-300 border border-pink-500/40 hover:bg-slate-700 transition">
          ◆ Apocrypha &amp; Ethiopian (18)
        </button>
        <button data-tradition="PROPHECY" class="trad-btn px-2.5 py-1 rounded text-xs font-medium bg-slate-800/90 text-yellow-200 border border-yellow-400/40 hover:bg-slate-700 transition">
          ★ Revelation (1)
        </button>

        <select id="cvdSelect" aria-label="Color vision simulation" class="ml-1 bg-slate-900 border border-slate-700 text-[11px] text-slate-300 rounded px-2 py-1">
          <option value="normal">Vision: Default (Okabe-Ito Safe)</option>
          <option value="deuteranopia">Simulate Deuteranopia (Red-Green CVD)</option>
          <option value="grayscale">Simulate Grayscale</option>
        </select>
      </div>
    </div>
  </header>

  <!-- ========================================================= -->
  <!-- WORKSPACE 1: 🗺️ JOURNEY (Interactive Atlas + Sidebar + Inspector) -->
  <!-- ========================================================= -->
  <main id="ws-journey" class="flex-1 max-w-[1840px] w-full mx-auto grid grid-cols-1 lg:grid-cols-12 gap-0 border-x border-slate-800/80">

    <!-- LEFT SIDEBAR: 84-Book & Writer Navigator -->
    <aside class="lg:col-span-3 border-r border-slate-800 bg-slate-900/60 flex flex-col h-[86vh]">
      <div class="p-3 border-b border-slate-800 space-y-2">
        <div class="flex items-center justify-between">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">
            Scriptural &amp; Apocryphal Catalog
          </h2>
          <span id="bookCountBadge" class="text-[11px] font-mono text-teal-300 bg-teal-950/80 px-2 py-0.5 rounded border border-teal-800/60">
            84 books
          </span>
        </div>

        <input id="bookSearchInput" type="search" placeholder="Search book, writer (Paul, Moses, Enoch...), city..."
          class="w-full bg-slate-950 border border-slate-700/80 rounded-md px-2.5 py-1.5 text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-teal-400" />

        <div class="flex items-center gap-1.5 text-[11px] text-slate-400 pt-0.5">
          <span>Filter Writer:</span>
          <select id="writerFilterSelect" class="flex-1 bg-slate-950 border border-slate-800 rounded px-2 py-1 text-xs text-slate-200">
            <option value="ALL">All Writers &amp; Traditions</option>
          </select>
        </div>
      </div>

      <div id="bookCatalogList" class="flex-1 overflow-y-auto custom-scroll divide-y divide-slate-800/60" role="listbox" aria-label="Books of the Bible and Apocrypha"></div>
    </aside>

    <!-- CENTER: Interactive D3 Map / Globe + 36-Step Journey Scrubber -->
    <section class="lg:col-span-6 flex flex-col h-[86vh] border-r border-slate-800 bg-slate-950">
      <!-- Map Toolbar -->
      <div class="px-3 py-2 border-b border-slate-800 bg-slate-900/80 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-1.5 flex-wrap">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 mr-1">Route Layer:</span>
          <button data-route="ALL" class="route-pill px-2 py-1 rounded text-xs font-medium bg-teal-600 text-white">All Journeys</button>
          <button data-route="OT_PATRIARCHS" class="route-pill px-2 py-1 rounded text-xs font-medium bg-slate-800 text-slate-300 hover:bg-slate-700">OT Patriarchs &amp; Exodus</button>
          <button data-route="NT_JESUS" class="route-pill px-2 py-1 rounded text-xs font-medium bg-slate-800 text-slate-300 hover:bg-slate-700">Gospels &amp; Galilee</button>
          <button data-route="APOC_EGYPT" class="route-pill px-2 py-1 rounded text-xs font-medium bg-slate-800 text-slate-300 hover:bg-slate-700">Holy Family in Egypt &amp; Aksum</button>
          <button data-route="NT_PAUL" class="route-pill px-2 py-1 rounded text-xs font-medium bg-slate-800 text-slate-300 hover:bg-slate-700">Acts &amp; Apostolic Missions</button>
        </div>

        <div class="flex items-center gap-1.5">
          <button id="toggleProjectionBtn" class="px-2.5 py-1 rounded text-xs font-medium bg-slate-800 hover:bg-slate-700 text-teal-300 border border-teal-500/30 transition">
            🌐 2D Atlas / 3D Globe
          </button>
          <button id="resetZoomBtn" class="px-2 py-1 rounded text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">
            Reset View
          </button>
        </div>
      </div>

      <!-- D3 SVG Canvas -->
      <div id="mapContainer" class="relative flex-1 map-surface overflow-hidden select-none">
        <svg id="atlasSvg" class="w-full h-full block" role="img" aria-label="Interactive Biblical and Apocryphal geographic map"></svg>

        <!-- Active Step Banner Overlay -->
        <div class="absolute top-3 left-3 right-3 pointer-events-none flex flex-wrap justify-between items-start gap-2">
          <div class="pointer-events-auto bg-slate-900/90 backdrop-blur border border-slate-700/80 rounded-lg px-3 py-2 max-w-md shadow-xl">
            <div class="flex items-center gap-2">
              <span id="activeStepBadge" class="text-[10px] font-bold uppercase px-1.5 py-0.5 rounded bg-teal-500/20 text-teal-300 border border-teal-500/40">
                STEP 1 / 36
              </span>
              <span id="activeStepEra" class="text-xs text-slate-400 font-mono">c. 2000 BCE • Genesis 11–12</span>
            </div>
            <h3 id="activeStepTitle" class="text-sm font-bold text-white mt-0.5">
              Ur of the Chaldees to Harran &amp; Canaan
            </h3>
            <p id="activeStepDesc" class="text-xs text-slate-300 mt-0.5 leading-relaxed">
              Abram journeys from Ur in Mesopotamia up the Euphrates to Harran, then south through Shechem, Bethel, and Hebron.
            </p>
          </div>

          <!-- Legend -->
          <div class="pointer-events-auto bg-slate-900/90 backdrop-blur border border-slate-800 rounded-lg p-2 text-[11px] space-y-1 shadow-lg">
            <div class="font-semibold text-slate-300 mb-1">Perceptual Encoding (Shape + Hue)</div>
            <div class="flex items-center gap-2"><span class="text-amber-400">■</span><span>Old Testament (Torah/Prophets/Writings)</span></div>
            <div class="flex items-center gap-2"><span class="text-sky-400">●</span><span>Gospels (Jesus's Earthly Ministry)</span></div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">▲</span><span>Acts &amp; Epistles (Paul &amp; Apostles)</span></div>
            <div class="flex items-center gap-2"><span class="text-pink-400">◆</span><span>Apocrypha / Egypt / Aksum / Enochic</span></div>
            <div class="flex items-center gap-2"><span class="text-yellow-300">★</span><span>Apocalyptic (Patmos &amp; 7 Churches)</span></div>
          </div>
        </div>

        <!-- Tooltip -->
        <div id="mapTooltip" class="hidden absolute z-30 pointer-events-none bg-slate-950/95 border border-slate-700 rounded-lg px-3 py-2 text-xs text-slate-100 shadow-2xl max-w-xs"></div>
      </div>

      <!-- Bottom Step-by-Step Chronological Scrubber -->
      <div class="p-3 border-t border-slate-800 bg-slate-900/95 space-y-2">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-1.5">
            <button id="prevStepBtn" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-200 border border-slate-700">
              ◀ Prev
            </button>
            <button id="playPauseBtn" class="px-3 py-1 rounded bg-teal-600 hover:bg-teal-500 text-xs font-semibold text-white shadow">
              ▶ Play Journey
            </button>
            <button id="nextStepBtn" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-200 border border-slate-700">
              Next ▶
            </button>
            <span class="text-[11px] text-slate-400 ml-2 hidden sm:inline">
              Keys: <kbd class="kbd">←</kbd> <kbd class="kbd">→</kbd> step
            </span>
          </div>

          <div class="text-xs font-mono text-slate-300">
            <span id="stepCounterText">Step 1 of 36</span>
          </div>
        </div>

        <input id="journeySlider" type="range" min="0" max="35" value="0" aria-label="Chronological journey step"
          class="w-full accent-teal-500 cursor-pointer h-1.5 bg-slate-800 rounded-lg" />

        <div id="stepQuickPills" class="flex items-center gap-1 overflow-x-auto custom-scroll pb-1 pt-0.5"></div>
      </div>
    </section>

    <!-- RIGHT INSPECTOR: Book Details, Writer Analysis, Complete Passage Breakdown -->
    <aside class="lg:col-span-3 bg-slate-900/60 flex flex-col h-[86vh] overflow-y-auto custom-scroll p-3.5 space-y-4">
      <!-- Active Book Header -->
      <div class="border-b border-slate-800 pb-3">
        <div class="flex items-center justify-between gap-2">
          <span id="inspTraditionBadge" class="text-[11px] font-bold uppercase px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/40">
            ■ OLD TESTAMENT
          </span>
          <span id="inspCanonStatus" class="text-[11px] text-slate-400 font-mono">Hebrew / Protestant / Catholic / Orthodox</span>
        </div>
        <h2 id="inspBookTitle" class="text-lg font-bold text-white mt-1.5">Genesis (Bereshit)</h2>
        <p id="inspBookSubtitle" class="text-xs text-slate-400">50 Chapters • c. 1440–1400 BCE (Trad.) / Persian Period Redaction</p>
      </div>

      <!-- Writer & Attribution Card -->
      <div class="bg-slate-950/90 border border-slate-800 rounded-lg p-3 space-y-1.5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-teal-400">Writer &amp; Attribution Analysis</div>
        <div class="text-xs"><span class="text-slate-400">Traditional Writer:</span> <strong id="inspWriterTrad" class="text-slate-100">Moses</strong></div>
        <div class="text-xs"><span class="text-slate-400">Historical / Redaction Notes:</span> <span id="inspWriterScholarly" class="text-slate-300">Mosaic core with Yahwist, Elohist &amp; Priestly scribal compilation</span></div>
        <div class="text-xs"><span class="text-slate-400">Primary Geographic Origin:</span> <span id="inspOriginPlace" class="text-teal-300 font-medium">Sinai / Plains of Moab</span></div>
      </div>

      <!-- Active Journey Step Context -->
      <div class="bg-slate-950/90 border border-slate-800 rounded-lg p-3 space-y-1.5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-sky-400">Active Geospatial Step</div>
        <div id="inspStepTitle" class="text-xs font-bold text-white">Step 1: Ur of the Chaldees to Harran &amp; Shechem</div>
        <p id="inspStepNarrative" class="text-xs text-slate-300 leading-relaxed">
          Abram departs Ur along the Euphrates crescent to Harran, then crosses into Canaan (Shechem, Bethel, Hebron) and down to the Nile Delta during famine.
        </p>
        <div id="inspStepPathList" class="text-[11px] font-mono text-teal-300 pt-1">Route: Ur → Harran → Shechem → Hebron</div>
      </div>

      <!-- Every Passage / Section Breakdown of Selected Book -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-300">Complete Passage Breakdown</h3>
          <span id="inspPassageCount" class="text-[11px] text-slate-400 font-mono">6 divisions</span>
        </div>
        <div id="inspPassagesList" class="space-y-2"></div>
      </div>

      <!-- Cross-Testament & Apocryphal Connections -->
      <div class="space-y-2 pt-2 border-t border-slate-800">
        <h3 class="text-xs font-bold uppercase tracking-wider text-pink-300">Connected Canonical &amp; Apocryphal Texts</h3>
        <div id="inspCrossLinks" class="space-y-1.5"></div>
      </div>
    </aside>
  </main>

  <!-- ========================================================= -->
  <!-- WORKSPACE 2: 📖 LIBRARY (Full 84-Book Searchable Table & Passage Explorer) -->
  <!-- ========================================================= -->
  <section id="ws-library" class="hidden flex-1 max-w-[1840px] w-full mx-auto p-4 space-y-4">
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-base font-bold text-white">📖 Complete 84-Book Scriptural &amp; Apocryphal Library</h2>
        <p class="text-xs text-slate-400">Every Old Testament (39), New Testament (27), and Apocryphal / Deuterocanonical / Ethiopian / Infancy book (18) with writer attributions and passage divisions.</p>
      </div>
      <div class="flex items-center gap-2">
        <input id="libSearchInput" type="search" placeholder="Filter 84 books by title, writer, passage, or city..."
          class="bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white w-72" />
      </div>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
      <div class="overflow-x-auto max-h-[75vh] custom-scroll">
        <table class="w-full text-left border-collapse text-xs">
          <thead class="bg-slate-950 text-slate-400 uppercase text-[11px] sticky top-0 z-10 border-b border-slate-800">
            <tr>
              <th class="py-2.5 px-3">#</th>
              <th class="py-2.5 px-3">Book</th>
              <th class="py-2.5 px-3">Corpus / Tradition</th>
              <th class="py-2.5 px-3">Chapters</th>
              <th class="py-2.5 px-3">Traditional &amp; Scholarly Writer</th>
              <th class="py-2.5 px-3">Date &amp; Origin</th>
              <th class="py-2.5 px-3">Complete Passage Divisions</th>
              <th class="py-2.5 px-3">Map Action</th>
            </tr>
          </thead>
          <tbody id="libraryTableBody" class="divide-y divide-slate-800/70"></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- WORKSPACE 3: 🧵 LOOM (Perceptually Honest Bar Charts: Writers, Volume & Canon Matrix) -->
  <!-- ========================================================= -->
  <section id="ws-loom" class="hidden flex-1 max-w-[1840px] w-full mx-auto p-4 space-y-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <!-- Chart 1: Sorted Horizontal Bar Chart by Writer Attribution -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-3">
        <div>
          <h2 class="text-sm font-bold text-white">Writer &amp; Scribal Attribution Across All 84 Books (Zero-Baseline Horizontal Bars)</h2>
          <p class="text-xs text-slate-400">Sorted by chapter volume. Uses position and length from a zero baseline for perceptual honesty rather than pie angles.</p>
        </div>
        <div id="writerBarChart" class="space-y-2 max-h-[520px] overflow-y-auto custom-scroll pr-2"></div>
      </div>

      <!-- Chart 2: Canon Inclusion Matrix & Corpus Distribution -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-3">
        <div>
          <h2 class="text-sm font-bold text-white">Canonical &amp; Apocryphal Tradition Comparison Matrix</h2>
          <p class="text-xs text-slate-400">Comparing book and chapter inclusion across Hebrew/Protestant, Catholic/Orthodox Deuterocanon, Ethiopian Ge'ez Canon, and Early Christian Apocrypha.</p>
        </div>
        <div id="canonMatrixContainer" class="space-y-3"></div>
      </div>
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- WORKSPACE 4: 🔗 LINKS (Cross-Testament, Prophecy Fulfillment & Apocryphal Parallels) -->
  <!-- ========================================================= -->
  <section id="ws-links" class="hidden flex-1 max-w-[1840px] w-full mx-auto p-4 space-y-4">
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
      <h2 class="text-base font-bold text-white">🔗 Intertextual Links: Old Testament, New Testament &amp; Apocrypha</h2>
      <p class="text-xs text-slate-400">Direct citations, prophetic fulfillments, and geographic bridges (including Jude quoting 1 Enoch, Matthew's Flight into Egypt, and Acts in Ethiopia/Arabia).</p>
    </div>
    <div id="linksGridContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3"></div>
  </section>

  <!-- APPLICATION SCRIPT (Single IIFE, Zero Duplicate Declarations, Safe DOM Bindings) -->
  <script>
  (function () {
    "use strict";

    // Null-safe DOM helpers so no missing element ever throws a TypeError
    function el(id) {
      return document.getElementById(id);
    }
    function bindOn(id, eventName, handler) {
      const node = document.getElementById(id);
      if (node) {
        node.addEventListener(eventName, handler);
      }
    }

    // 1. PERCEPTUALLY HONEST OKABE-ITO TRADITION METADATA
    const TRADITION_META = {
      OT:         { key: "OT",         label: "Old Testament",          symbol: "■", color: "#E69F00", badgeClass: "bg-amber-500/20 text-amber-300 border-amber-500/40" },
      NT_GOSPEL:  { key: "NT_GOSPEL",  label: "Gospels",                symbol: "●", color: "#56B4E9", badgeClass: "bg-sky-500/20 text-sky-300 border-sky-500/40" },
      NT_EPISTLE: { key: "NT_EPISTLE", label: "Acts & Epistles",        symbol: "▲", color: "#009E73", badgeClass: "bg-emerald-500/20 text-emerald-300 border-emerald-500/40" },
      APOCRYPHA:  { key: "APOCRYPHA",  label: "Apocrypha & Ethiopian",  symbol: "◆", color: "#CC79A7", badgeClass: "bg-pink-500/20 text-pink-300 border-pink-500/40" },
      PROPHECY:   { key: "PROPHECY",   label: "Apocalyptic / Prophecy", symbol: "★", color: "#F0E442", badgeClass: "bg-yellow-500/20 text-yellow-200 border-yellow-400/40" }
    };
    const TRADITIONS = TRADITION_META;
    function getTradition(key) {
      return TRADITION_META[key] || TRADITION_META.OT;
    }

    // 2. GEOGRAPHIC PLACES CATALOG (Lat/Lon Coordinates for Ancient Near East, Mediterranean, Egypt, Ethiopia & India)
    const PLACES = {
