      /* =====================================================================
         4. CUMULATIVE 36-STEP GEOSPATIAL JOURNEY ATLAS
         Covers OT Patriarchs/Exodus/Exile, Gospels in Galilee/Judea,
         Holy Family Flight across Egypt & Ethiopian/Aksumite Traditions,
         and Acts/Apostolic Missions to Rome & Patmos.
         ===================================================================== */
      const JOURNEY_STEPS = [
        // --- LAYER 1: OT PATRIARCHS, EXODUS, MONARCHY & EXILE (Steps 1–10) ---
        { step: 1, group: "OT_PATRIARCHS", bookId: "GEN", from: "Ur", to: "Hebron", waypoints: ["Ur", "Harran", "Shechem", "Hebron"],
          title: "Ur of the Chaldees to Harran & Shechem",
          summary: "Abram departs Ur along the Euphrates crescent to Harran, then crosses into Canaan (Shechem, Bethel, Hebron) and down to the Nile Delta during famine." },
        { step: 2, group: "OT_PATRIARCHS", bookId: "GEN", from: "Hebron", to: "Memphis", waypoints: ["Hebron", "Gaza", "Pelusium", "Memphis"],
          title: "Joseph & Jacob's House Descend into Egypt",
          summary: "Sold by his brothers at Dothan, Joseph rises in Pharaoh's court at Memphis/Heliopolis (On), welcoming Jacob's seventy souls into Goshen (Gen 37–50)." },
        { step: 3, group: "OT_PATRIARCHS", bookId: "EXO", from: "Memphis", to: "Sinai", waypoints: ["Memphis", "Pelusium", "Sinai"],
          title: "The Exodus from Egypt to Mount Sinai",
          summary: "Moses leads Israel from Rameses/Goshen through the Sea to Mount Sinai (Horeb), receiving the Torah Decalogue and Tabernacle covenant (Exo 12–40; Lev 1–27)." },
        { step: 4, group: "OT_PATRIARCHS", bookId: "DEU", from: "Sinai", to: "Shechem", waypoints: ["Sinai", "Jericho", "Shechem"],
          title: "Plains of Moab, Jordan Crossing & Shechem Covenant",
          summary: "After Moses's farewell addresses in Deuteronomy, Joshua leads Israel across the Jordan at Jericho and renews the covenant between Mt. Ebal and Gerizim (Jos 1–24)." },
        { step: 5, group: "OT_PATRIARCHS", bookId: "2SA", from: "Bethlehem", to: "Jerusalem", waypoints: ["Bethlehem", "Hebron", "Jerusalem"],
          title: "Bethlehem, Hebron & David's Zion (First Temple)",
          summary: "From Ruth's fields in Bethlehem and David's anointing at Hebron, Jerusalem becomes the royal and liturgical capital where Psalms, Proverbs & Solomon's Temple flourish." },
        { step: 6, group: "OT_PATRIARCHS", bookId: "1KI", from: "Shechem", to: "Aksum", waypoints: ["Jerusalem", "Sinai", "Meroe", "Aksum"],
          title: "Queen of Sheba's Royal Caravan & Elijah at Horeb",
          summary: "The Queen of the South (Sheba/Saba & Aksumite tradition in 1 Ki 10; 2 Chr 9; Kebra Nagast) visits Solomon in Jerusalem, while Elijah journeys back to Horeb (1 Ki 19)." },
        { step: 7, group: "OT_PATRIARCHS", bookId: "JON", from: "Joppa", to: "Nineveh", waypoints: ["Nazareth", "Joppa", "Nineveh"],
          title: "Prophets to Assyria: Jonah, Nahum & Tobit in Nineveh",
          summary: "Jonah boards a ship at Joppa before preaching in Nineveh; after Samaria's fall (722 BCE), Tobit practices charity among the exiles in Nineveh (Jon 1–4; Tob 1–14)." },
        { step: 8, group: "OT_PATRIARCHS", bookId: "JER", from: "Jerusalem", to: "Syene", waypoints: ["Jerusalem", "Pelusium", "Memphis", "Syene"],
          title: "Jeremiah & Baruch's Forced Flight into Egypt",
          summary: "Following Babylon's destruction of Jerusalem (586 BCE), a Judean remnant takes Jeremiah and his scribe Baruch to Tahpanhes (Pelusium), Memphis, and Pathros/Syene (Jer 43–44)." },
        { step: 9, group: "OT_PATRIARCHS", bookId: "EZK", from: "Jerusalem", to: "Susa", waypoints: ["Jerusalem", "Babylon", "Susa"],
          title: "Babylonian Exile & Persian Court at Susa",
          summary: "Ezekiel beholds the Merkabah throne by the Kebar Canal in Babylon, while Daniel and Queen Esther witness divine providence in Babylon and Susa (Ezk 1; Dan 1–12; Est 1–10)." },
        { step: 10, group: "OT_PATRIARCHS", bookId: "NEH", from: "Susa", to: "Jerusalem", waypoints: ["Susa", "Babylon", "Jerusalem"],
          title: "Return from Exile: Zerubbabel, Ezra & Nehemiah",
          summary: "Under Cyrus, Darius, and Artaxerxes, exiles return from Babylon and Susa to rebuild the Second Temple and Jerusalem's walls, joined by Haggai, Zechariah & Malachi." },

        // --- LAYER 2: HOLY FAMILY IN EGYPT, DEUTEROCANON & ETHIOPIAN CANON (Steps 11–20) ---
        { step: 11, group: "HOLY_FAMILY_AFRICA", bookId: "MAT", from: "Bethlehem", to: "Bubastis", waypoints: ["Bethlehem", "Gaza", "Pelusium", "Bubastis"],
          title: "Flight into Egypt: Bethlehem via Gaza & Sinai to Tel Basta",
          summary: "Warned in a dream (Mat 2:13–15), Joseph takes Mary and the Child Jesus from Bethlehem along the coastal Way of the Sea through Gaza and Pelusium (Farama) to Tel Basta (Bubastis), where a spring flows." },
        { step: 12, group: "HOLY_FAMILY_AFRICA", bookId: "INF", from: "Bubastis", to: "Memphis", waypoints: ["Bubastis", "Heliopolis", "Memphis"],
