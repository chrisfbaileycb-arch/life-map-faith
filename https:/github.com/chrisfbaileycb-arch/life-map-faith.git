        { step: 35, group: "APOSTOLIC_ACTS", bookId: "1PE", from: "Jerusalem", to: "Rome", waypoints: ["Jerusalem", "Antioch", "Corinth", "Rome"],
          title: "Catholic Epistles Across the Diaspora: James, Peter, Hebrews & Jude",
          summary: "From Jerusalem, James and Jude exhort the Twelve Tribes in the Dispersion; Peter writes 1–2 Peter from Rome ('Babylon', 1 Pe 5:13) via Silvanus; and Hebrews proclaims Christ's eternal Melchizedek priesthood." },
        { step: 36, group: "APOSTOLIC_ACTS", bookId: "REV", from: "Ephesus", to: "Patmos", waypoints: ["Jerusalem", "Ephesus", "Patmos", "Laodicea"],
          title: "John on the Isle of Patmos: Seven Churches of Asia & New Jerusalem",
          summary: "Exiled on Patmos in the Aegean Sea, John receives the Apocalypse (Rev 1–22), sending letters to the Seven Churches of Asia (Ephesus to Laodicea) and beholding the New Jerusalem where the Tree of Life heals the nations." }
      ];

      /* =====================================================================
         5. CROSS-TESTAMENT & APOCRYPHAL TEXTUAL LINKS (LOOM & LINKS DATA)
         ===================================================================== */
      const CROSS_LINKS = [
        { id: "L01", category: "AFRICAN_REFUGE", sourceBook: "HOS", sourceRef: "Hosea 11:1 / Isaiah 19:1,19", targetBook: "MAT", targetRef: "Matthew 2:13–23 & Infancy Homilies", place: "Muharraq",
          theme: "Out of Egypt I Called My Son & Altar in the Midst of Egypt",
          note: "Links Israel's Exodus and Isaiah's oracle of an altar in the geographical center of Egypt (Assiut / Deir al-Muharraq) with the Holy Family's 3.5-year flight across the Nile Delta and Upper Egypt." },
        { id: "L02", category: "ETHIOPIAN_CANON", sourceBook: "1KI", sourceRef: "1 Kings 10:1–13 / Psalm 68:31", targetBook: "ACT", targetRef: "Matthew 12:42 / Acts 8:26–40 / Kebra Nagast", place: "Aksum",
          theme: "Queen of the South (Sheba) & the Ethiopian Treasurer on the Gaza Road",
          note: "Connects Solomon's reception of Queen Makeda, Jesus's praise of the Queen of the South, Philip's baptism of the Candace's treasurer reading Isaiah 53, and Aksumite Zion tradition." },
        { id: "L03", category: "ETHIOPIAN_CANON", sourceBook: "1EN", sourceRef: "1 Enoch 1:9 & 46:1–4 (Ge'ez / Qumran)", targetBook: "JUD", targetRef: "Jude 14–15 & Matthew 25:31", place: "Aksum",
          theme: "Prophecy of Enoch the Seventh from Adam & Son of Man on His Glorious Throne",
          note: "Jude 14–15 directly quotes 1 Enoch 1:9; the Similitudes of Enoch (1 En 37–71), preserved intact in the Ethiopian Tewahedo canon, parallel the Son of Man judgment scenes in the Gospels." },
        { id: "L04", category: "MESSIANIC", sourceBook: "ISA", sourceRef: "Isaiah 7:14, 9:6, 53:1–12 (1QIsa-a)", targetBook: "LUK", targetRef: "Luke 4:18–21 / John 12:38 / 1 Peter 2:22–25", place: "Qumran",
          theme: "The Suffering Servant & Anointed Herald of Good News",
          note: "The Great Isaiah Scroll at Qumran (c. 125 BCE) preserves verbatim the Servant Songs read by Jesus in the Nazareth synagogue and expounded by Philip, Paul, and Peter." },
        { id: "L05", category: "WISDOM_LOGOS", sourceBook: "WIS", sourceRef: "Proverbs 8:22–31 / Wisdom 7:25–26 / Sirach 24", targetBook: "JHN", targetRef: "John 1:1–14 / Colossians 1:15–17 / Hebrews 1:3", place: "Alexandria",
          theme: "Divine Wisdom (Sophia / Logos) as the Radiance of God's Glory",
          note: "Alexandrian Jewish wisdom literature describes Wisdom as the 'breath of the power of God and spotless mirror' (Wis 7:25–26) and 'effulgence of eternal light'—language directly echoed in John 1 and Hebrews 1:3." },
        { id: "L06", category: "RESURRECTION", sourceBook: "2MA", sourceRef: "Daniel 12:2 / 2 Maccabees 7:9–14", targetBook: "HEB", targetRef: "Hebrews 11:35 / 1 Corinthians 15", place: "Cyrene",
          theme: "Martyrs' Hope of Bodily Resurrection ('Not Accepting Release')",
          note: "Hebrews 11:35 ('others were tortured, refusing to accept release, that they might rise again to a better life') directly references the Maccabean mother and seven sons recorded by Jason of Cyrene in 2 Maccabees 7." },
        { id: "L07", category: "COVENANT_PRIESTHOOD", sourceBook: "GEN", sourceRef: "Genesis 14:18 / Psalm 110:4 / Jubilees 13", targetBook: "HEB", targetRef: "Hebrews 5:6–10 & 7:1–28", place: "Jerusalem",
          theme: "Royal Priesthood Forever After the Order of Melchizedek",
          note: "Abraham's encounter with Melchizedek King of Salem and David's enthronement psalm become the cornerstone of Hebrews' exposition of Christ's eternal high priesthood." },
        { id: "L08", category: "APOCALYPTIC", sourceBook: "EZK", sourceRef: "Ezekiel 1, 37, 47 / Daniel 7:9–14", targetBook: "REV", targetRef: "Revelation 4–5, 21–22", place: "Patmos",
          theme: "The Four Living Creatures, Ancient of Days & River of the Water of Life",
          note: "John on Patmos weaves Ezekiel's Merkabah throne vision and temple river of life (Ezk 47) with Daniel's Son of Man and Genesis's Tree of Life into the New Jerusalem." },
        { id: "L09", category: "AFRICAN_REFUGE", sourceBook: "JER", sourceRef: "Jeremiah 43–44 & Baruch 1", targetBook: "MRK", targetRef: "Acts 2:10, 11:20, 13:1, 18:24 & 1 Peter 5:13", place: "Memphis",
          theme: "Jewish & Apostolic Diaspora Across Memphis, Cyrene & Alexandria",
          note: "From Jeremiah's remnant in Tahpanhes and Memphis to Simon of Cyrene, Lucius of Cyrene at Antioch, Apollos of Alexandria, and John Mark's mission, North and East Africa form a continuous scriptural artery." },
        { id: "L10", category: "WISDOM_LOGOS", sourceBook: "MAT", sourceRef: "Matthew 13 / Luke 11:9–13", targetBook: "GTH", targetRef: "Oxyrhynchus Papyri (P.Oxy 1, 654) & Nag Hammadi Logia", place: "Oxyrhynchus",
          theme: "Parables of the Sower, Mustard Seed, Pearl & Seeking the Kingdom",
          note: "Early Greek papyrus fragments from Oxyrhynchus (Al-Bahnasa) and Coptic codices from Nag Hammadi preserve sayings traditions that illuminate how Gospel parables circulated along the Upper Nile." }
      ];

      /* =====================================================================
         6. FAST LOOKUP MAPS & STATE MANAGEMENT
         ===================================================================== */
      const BOOK_BY_ID = Object.fromEntries(BOOKS.map(b => [b.id, b]));

      const state = {
        workspace: "journey",      // 'journey' | 'library' | 'loom' | 'links'
        traditionFilter: "ALL",    // 'ALL' | 'OT' | 'NT_GOSPEL' | 'NT_EPISTLE' | 'APOCRYPHA' | 'PROPHECY'
        routeGroup: "ALL",         // 'ALL' | 'OT_PATRIARCHS' | 'HOLY_FAMILY_AFRICA' | 'GOSPELS_GALILEE' | 'APOSTOLIC_ACTS'
        stepIndex: 0,              // index into filteredSteps
        selectedBookId: "GEN",
        selectedPlaceKey: "Ur",
        is3D: false,
        isPlaying: false,
        playTimer: null,
        searchQuery: "",
        libraryTradition: "ALL",
        linkCategory: "ALL",
        worldGeo: null,
        globeRotation: [-33, -24, 0]
      };

      function getFilteredSteps() {
        return JOURNEY_STEPS.filter(s => {
          const book = BOOK_BY_ID[s.bookId];
          const matchRoute = state.routeGroup === "ALL" || s.group === state.routeGroup;
          const matchTrad = state.traditionFilter === "ALL" || (book && book.tradition === state.traditionFilter);
          return matchRoute && matchTrad;
        });
      }

      /* =====================================================================
         7. D3 MAP & 3D GLOBE ENGINE
         ===================================================================== */
      const svg = d3.select("#atlas-svg");
      const width = 1000;
      const height = 620;

      const defs = svg.append("defs");
      // Glow filter for active nodes & routes
      const glowFilter = defs.append("filter")
        .attr("id", "route-glow")
        .attr("x", "-30%").attr("y", "-30%")
        .attr("width", "160%").attr("height", "160%");
      glowFilter.append("feGaussianBlur").attr("stdDeviation", "3.5").attr("result", "coloredBlur");
      const feMerge = glowFilter.append("feMerge");
      feMerge.append("feMergeNode").attr("in", "coloredBlur");
      feMerge.append("feMergeNode").attr("in", "SourceGraphic");

      // Directional arrowhead marker
      defs.append("marker")
        .attr("id", "arrow-active")
        .attr("viewBox", "0 -5 10 10")
        .attr("refX", 7)
        .attr("refY", 0)
        .attr("markerWidth", 6)
        .attr("markerHeight", 6)
        .attr("orient", "auto")
        .append("path")
        .attr("d", "M0,-4L10,0L0,4")
        .attr("fill", "#2dd4bf");

      const mapRoot = svg.append("g").attr("id", "map-zoom-root");
      const oceanLayer = mapRoot.append("g").attr("class", "layer-ocean");
      const graticuleLayer = mapRoot.append("g").attr("class", "layer-graticule");
      const landLayer = mapRoot.append("g").attr("class", "layer-land");
      const riverLayer = mapRoot.append("g").attr("class", "layer-rivers");
      const routeBgLayer = mapRoot.append("g").attr("class", "layer-routes-bg");
      const routeActiveLayer = mapRoot.append("g").attr("class", "layer-routes-active");
      const nodeLayer = mapRoot.append("g").attr("class", "layer-nodes");
      const labelLayer = mapRoot.append("g").attr("class", "layer-labels");

      // Geographic reference rivers (Nile, Euphrates, Tigris, Jordan)
      const BIBLICAL_RIVERS = [
        {
          name: "Nile River (White, Blue & Delta)",
          coords: [[38.7, 14.1], [33.7, 16.9], [32.9, 24.09], [32.3, 26.05], [30.7, 27.38], [30.8, 27.78], [30.7, 28.53], [31.25, 29.85], [31.1, 31.2]]
        },
        {
          name: "Euphrates River",
          coords: [[39.0, 38.0], [39.03, 36.86], [42.5, 34.0], [44.42, 32.54], [46.10, 30.96], [48.0, 30.0]]
        },
        {
          name: "Tigris River",
          coords: [[40.2, 37.9], [43.15, 36.36], [44.4, 33.3], [48.0, 30.0]]
        },
        {
          name: "Jordan River",
          coords: [[35.69, 33.24], [35.57, 32.88], [35.46, 31.86], [35.5, 31.5]]
        }
      ];

      function getProjection() {
        if (state.is3D) {
          return d3.geoOrthographic()
            .scale(520)
            .translate([width / 2, height / 2])
            .rotate(state.globeRotation)
            .clipAngle(90);
        }
        return d3.geoMercator()
          .center([35.2, 27.8])
          .scale(1080)
          .translate([width / 2, height / 2]);
      }

      const zoomBehavior = d3.zoom()
        .scaleExtent([0.65, 9])
        .on("zoom", (event) => {
          if (!state.is3D) {
            mapRoot.attr("transform", event.transform);
          }
        });

      svg.call(zoomBehavior);

      // Drag behavior for 3D Orthographic Globe mode
      const globeDrag = d3.drag()
        .on("drag", (event) => {
          if (!state.is3D) return;
          const r = state.globeRotation;
          const sens = 0.25;
          state.globeRotation = [
            r[0] + event.dx * sens,
            Math.max(-65, Math.min(65, r[1] - event.dy * sens)),
            r[2]
          ];
          renderAtlas();
        });

      // Fallback simplified Mediterranean / Nile / Fertile Crescent coastline polygons if offline
      const FALLBACK_LAND = {
        type: "FeatureCollection",
        features: [
          {
            type: "Feature",
            properties: { name: "Afro-Eurasian Biblical Lands" },
            geometry: {
              type: "Polygon",
              coordinates: [[
                [10, 37], [25, 32], [32, 31.5], [34.5, 31.2], [35.8, 33.5], [36.1, 36.5],
                [27, 36.5], [26, 40], [20, 40], [15, 41], [12, 42], [14, 45], [28, 42],
                [40, 41], [52, 38], [52, 24], [43, 12], [39, 15], [34, 28], [32.5, 29.9],
                [35, 24], [42, 11], [35, 5], [10, 5], [10, 37]
              ]]
            }
          }
        ]
      };

      // Load TopoJSON World Atlas
      fetch("https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json")
        .then(r => r.json())
        .then(worldData => {
          if (window.topojson && worldData.objects && worldData.objects.countries) {
            state.worldGeo = topojson.feature(worldData, worldData.objects.countries);
          } else {
            state.worldGeo = FALLBACK_LAND;
          }
          renderAtlas();
        })
        .catch(() => {
          state.worldGeo = FALLBACK_LAND;
          renderAtlas();
        });

      // Helper for SVG node shapes based on tradition
      function getNodeSymbolPath(traditionKey, radius = 5.5) {
        const trad = getTradition(traditionKey);
        const r = radius;
        switch (trad.shape) {
          case "square":
            return `M ${-r},${-r} L ${r},${-r} L ${r},${r} L ${-r},${r} Z`;
          case "triangle":
            return `M 0,${-r * 1.25} L ${r * 1.15},${r} L ${-r * 1.15},${r} Z`;
          case "diamond":
            return `M 0,${-r * 1.3} L ${r * 1.3},0 L 0,${r * 1.3} L ${-r * 1.3},0 Z`;
          case "star": {
            const pts = [];
            for (let i = 0; i < 10; i++) {
              const rad = i % 2 === 0 ? r * 1.35 : r * 0.58;
              const angle = (Math.PI / 5) * i - Math.PI / 2;
              pts.push(`${(Math.cos(angle) * rad).toFixed(2)},${(Math.sin(angle) * rad).toFixed(2)}`);
            }
            return `M ${pts.join(" L ")} Z`;
          }
          case "circle":
          default:
            return `M ${-r},0 a ${r},${r} 0 1,0 ${r * 2},0 a ${r},${r} 0 1,0 ${-r * 2},0`;
        }
      }

      function renderAtlas() {
        const projection = getProjection();
        const pathGen = d3.geoPath().projection(projection);

        oceanLayer.selectAll("*").remove();
        graticuleLayer.selectAll("*").remove();
        landLayer.selectAll("*").remove();
        riverLayer.selectAll("*").remove();
        routeBgLayer.selectAll("*").remove();
        routeActiveLayer.selectAll("*").remove();
        nodeLayer.selectAll("*").remove();
        labelLayer.selectAll("*").remove();

        if (state.is3D) {
          oceanLayer.append("path")
            .datum({ type: "Sphere" })
            .attr("d", pathGen)
            .attr("fill", "#081226")
            .attr("stroke", "#1e3a5f")
            .attr("stroke-width", 1.5);
        }

        const graticule = d3.geoGraticule().step([5, 5]);
        graticuleLayer.append("path")
          .datum(graticule())
          .attr("d", pathGen)
          .attr("fill", "none")
          .attr("stroke", "#1e293b")
          .attr("stroke-width", 0.5)
          .attr("stroke-dasharray", "2,2");

        const geoData = state.worldGeo || FALLBACK_LAND;
        landLayer.selectAll("path")
          .data(geoData.features)
          .enter()
          .append("path")
          .attr("d", pathGen)
          .attr("fill", "#162235")
          .attr("stroke", "#283952")
          .attr("stroke-width", 0.7);

        // Render major biblical rivers
        riverLayer.selectAll("path")
          .data(BIBLICAL_RIVERS)
          .enter()
          .append("path")
          .attr("d", d => pathGen({ type: "LineString", coordinates: d.coords }))
          .attr("fill", "none")
          .attr("stroke", "#1d4ed8")
          .attr("stroke-opacity", 0.55)
          .attr("stroke-width", 1.8);

        const steps = getFilteredSteps();
        const activeStep = steps[Math.min(state.stepIndex, Math.max(0, steps.length - 1))] || JOURNEY_STEPS[0];
        const activeBook = BOOK_BY_ID[activeStep.bookId] || BOOKS[0];
        const activeTrad = getTradition(activeBook.tradition);

        // Background routes (all steps in current filter)
        steps.forEach((st, idx) => {
          const coords = st.waypoints.map(wp => PLACES[wp]?.coords).filter(Boolean);
          if (coords.length < 2) return;
          const b = BOOK_BY_ID[st.bookId] || BOOKS[0];
          const tr = getTradition(b.tradition);
          const isPast = idx < state.stepIndex;

          routeBgLayer.append("path")
            .datum({ type: "LineString", coordinates: coords })
            .attr("d", pathGen)
            .attr("fill", "none")
            .attr("stroke", tr.color)
            .attr("stroke-width", isPast ? 2.1 : 1.1)
            .attr("stroke-opacity", isPast ? 0.45 : 0.18)
            .attr("stroke-dasharray", tr.dash);
        });

        // Active Step Highlighted Route
        if (activeStep) {
          const activeCoords = activeStep.waypoints.map(wp => PLACES[wp]?.coords).filter(Boolean);
          if (activeCoords.length >= 2) {
            routeActiveLayer.append("path")
              .datum({ type: "LineString", coordinates: activeCoords })
              .attr("d", pathGen)
              .attr("fill", "none")
              .attr("stroke", activeTrad.color)
              .attr("stroke-width", 3.6)
              .attr("stroke-linecap", "round")
              .attr("filter", "url(#route-glow)")
              .attr("marker-end", "url(#arrow-active)");
          }
        }

        // Determine primary tradition for each place
        const activeWaypoints = new Set(activeStep ? activeStep.waypoints : []);
        const placeEntries = Object.entries(PLACES);

        placeEntries.forEach(([placeKey, place]) => {
          const projected = projection(place.coords);
          if (!projected) return;

          // Check visibility on 3D globe hemisphere
          if (state.is3D) {
            const centerLon = -state.globeRotation[0];
            const centerLat = -state.globeRotation[1];
            const dist = d3.geoDistance(place.coords, [centerLon, centerLat]);
            if (dist > Math.PI / 2) return;
          }

          const isWaypoint = activeWaypoints.has(placeKey);
          const isSelected = state.selectedPlaceKey === placeKey;

          // Determine tradition color for node
          const matchingBook = BOOKS.find(b => b.origin === placeKey) || activeBook;
          const nodeTrad = getTradition(matchingBook.tradition);
          const radius = isWaypoint || isSelected ? 6.8 : 4.5;

          const g = nodeLayer.append("g")
            .attr("transform", `translate(${projected[0]},${projected[1]})`)
            .style("cursor", "pointer")
            .on("click", (event) => {
              event.stopPropagation();
              selectPlace(placeKey);
            });

          if (isWaypoint || isSelected) {
            g.append("circle")
              .attr("r", 12)
              .attr("fill", nodeTrad.color)
              .attr("fill-opacity", 0.22)
              .attr("stroke", nodeTrad.color)
              .attr("stroke-width", 1)
              .attr("stroke-opacity", 0.6);
          }

          g.append("path")
            .attr("d", getNodeSymbolPath(matchingBook.tradition, radius))
            .attr("fill", isWaypoint ? nodeTrad.color : "#0f172a")
            .attr("stroke", nodeTrad.color)
            .attr("stroke-width", isWaypoint || isSelected ? 2.2 : 1.5);

          // Labels for active waypoints, selected place, or key anchors
          const majorHubs = new Set(["Jerusalem", "Alexandria", "Rome", "Babylon", "Aksum", "Muharraq", "Antioch", "Sinai", "Ur", "Memphis", "Qumran", "Patmos"]);
          if (isWaypoint || isSelected || majorHubs.has(placeKey)) {
            labelLayer.append("text")
              .attr("x", projected[0] + 8)
              .attr("y", projected[1] + 3)
              .attr("fill", isWaypoint || isSelected ? "#ffffff" : "#94a3b8")
              .attr("font-size", isWaypoint || isSelected ? "11.5px" : "9.5px")
              .attr("font-weight", isWaypoint || isSelected ? "700" : "500")
              .attr("paint-order", "stroke")
              .attr("stroke", "#090d16")
              .attr("stroke-width", "3px")
              .style("pointer-events", "none")
              .text(place.name.split(" (")[0]);
          }
        });
      }

      /* =====================================================================
         8. UI SYNCHRONIZATION & INSPECTOR UPDATERS
         ===================================================================== */
      function updateJourneyUI() {
        const steps = getFilteredSteps();
        if (steps.length === 0) return;

        if (state.stepIndex >= steps.length) state.stepIndex = 0;
        const step = steps[state.stepIndex];
        const book = BOOK_BY_ID[step.bookId] || BOOKS[0];
        const trad = getTradition(book.tradition);

        state.selectedBookId = book.id;
        state.selectedPlaceKey = step.to || step.waypoints[0];

        // Scrubber & Step Counter
        const scrubber = document.getElementById("step-scrubber");
        scrubber.max = Math.max(0, steps.length - 1);
        scrubber.value = state.stepIndex;
        document.getElementById("step-counter-badge").textContent = `Step ${state.stepIndex + 1} of ${steps.length}`;

        // Active Book Inspector Header
        const badgeEl = document.getElementById("insp-tradition-badge");
        badgeEl.textContent = `${trad.symbol} ${trad.label.toUpperCase()}`;
        badgeEl.style.color = trad.color;
        badgeEl.style.borderColor = `${trad.color}66`;

        document.getElementById("insp-book-title").textContent = book.title;
        document.getElementById("insp-book-chapters").textContent = `${book.chapters} ${book.chapters === 1 ? "Chapter" : "Chapters"}`;
        document.getElementById("insp-book-date").textContent = book.date;
        document.getElementById("insp-writer-name").textContent = book.writer;
        document.getElementById("insp-writer-notes").textContent = book.writerNotes;
        document.getElementById("insp-origin-place").textContent = PLACES[book.origin]?.name || book.origin;

        // Active Step Card
        document.getElementById("insp-step-title").textContent = `Step ${step.step}: ${step.title}`;
        document.getElementById("insp-step-summary").textContent = step.summary;
        const wpNames = step.waypoints.map(k => (PLACES[k]?.name || k).split(" (")[0]).join(" → ");
        document.getElementById("insp-step-route").textContent = `Route: ${wpNames}`;

        // Passage Breakdown List
        const passageList = document.getElementById("insp-passage-list");
        document.getElementById("insp-passage-count").textContent = `${book.passages.length} divisions`;
        passageList.innerHTML = book.passages.map(p => {
          const pName = PLACES[p.place]?.name || p.place;
          return `
            <div class="p-2.5 rounded-lg bg-slate-900/90 border border-slate-800 hover:border-teal-500/50 transition cursor-pointer" data-place-jump="${p.place}">
              <div class="flex items-center justify-between gap-2 mb-0.5">
                <span class="text-xs font-bold font-mono text-teal-300">${p.ref}</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-300">📍 ${pName.split(" (")[0]}</span>
              </div>
              <p class="text-xs text-slate-200 leading-snug">${p.title}</p>
            </div>
          `;
        }).join("");

        passageList.querySelectorAll("[data-place-jump]").forEach(el => {
          el.addEventListener("click", () => {
            const pk = el.getAttribute("data-place-jump");
            if (PLACES[pk]) selectPlace(pk);
          });
        });

        // Related Cross-Testament & Apocryphal Links
        const relatedLinks = CROSS_LINKS.filter(
          l => l.sourceBook === book.id || l.targetBook === book.id || step.waypoints.includes(l.place)
        ).slice(0, 4);

        const linksContainer = document.getElementById("insp-cross-links");
        const listToRender = relatedLinks.length > 0 ? relatedLinks : CROSS_LINKS.slice(0, 2);
        linksContainer.innerHTML = listToRender.map(l => `
          <div class="p-2.5 rounded-lg bg-slate-900/70 border border-slate-800/90 text-xs">
            <div class="flex items-center justify-between gap-1 text-[11px] font-semibold text-amber-300 mb-0.5">
              <span>${l.sourceRef}</span>
              <span>⇄</span>
              <span class="text-sky-300">${l.targetRef}</span>
            </div>
            <div class="font-medium text-white mb-0.5">${l.theme}</div>
            <p class="text-[11px] text-slate-400 leading-relaxed">${l.note}</p>
          </div>
        `).join("");

        // Rotate 3D globe if enabled
        const targetPlace = PLACES[step.to] || PLACES[step.waypoints[0]];
        if (state.is3D && targetPlace) {
          state.globeRotation = [-targetPlace.coords[0], -targetPlace.coords[1], 0];
        }

        updatePlaceCard(state.selectedPlaceKey);
        renderAtlas();
      }

      function updatePlaceCard(placeKey) {
        const place = PLACES[placeKey];
        if (!place) return;
        document.getElementById("place-card-name").textContent = place.name;
        document.getElementById("place-card-region").textContent = `${place.region} • (${place.coords[1].toFixed(2)}°N, ${place.coords[0].toFixed(2)}°E)`;
        document.getElementById("place-card-desc").textContent = place.desc;

        const relatedBooks = BOOKS.filter(b =>
          b.origin === placeKey || b.passages.some(p => p.place === placeKey)
        );
        const pillsEl = document.getElementById("place-card-books");
        pillsEl.innerHTML = relatedBooks.slice(0, 8).map(b => {
          const tr = getTradition(b.tradition);
          return `<button data-book-jump="${b.id}" class="text-[10px] px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">${tr.symbol} ${b.title.split(" (")[0]}</button>`;
        }).join("");

        pillsEl.querySelectorAll("[data-book-jump]").forEach(btn => {
          btn.addEventListener("click", () => {
            jumpToBook(btn.getAttribute("data-book-jump"));
          });
        });
      }

      function selectPlace(placeKey) {
        if (!PLACES[placeKey]) return;
        state.selectedPlaceKey = placeKey;
        updatePlaceCard(placeKey);
        renderAtlas();
      }

      function jumpToBook(bookId) {
        const book = BOOK_BY_ID[bookId];
        if (!book) return;
        state.selectedBookId = bookId;

        // Reset filters if needed so book's step is reachable
        state.traditionFilter = "ALL";
        state.routeGroup = "ALL";
        document.getElementById("route-group-select").value = "ALL";
        syncTraditionButtons();

        const stepIdx = JOURNEY_STEPS.findIndex(s => s.bookId === bookId);
        if (stepIdx !== -1) {
          state.stepIndex = stepIdx;
        }
        switchWorkspace("journey");
        updateJourneyUI();

        // Also update Inspector directly to this book even if shared step
        const trad = getTradition(book.tradition);
        const badgeEl = document.getElementById("insp-tradition-badge");
        badgeEl.textContent = `${trad.symbol} ${trad.label.toUpperCase()}`;
        badgeEl.style.color = trad.color;
        document.getElementById("insp-book-title").textContent = book.title;
        document.getElementById("insp-book-chapters").textContent = `${book.chapters} Chapters`;
        document.getElementById("insp-book-date").textContent = book.date;
        document.getElementById("insp-writer-name").textContent = book.writer;
        document.getElementById("insp-writer-notes").textContent = book.writerNotes;
        document.getElementById("insp-origin-place").textContent = PLACES[book.origin]?.name || book.origin;
        selectPlace(book.origin);
      }

      /* =====================================================================
         9. WORKSPACE 2: COMPLETE 84-BOOK LIBRARY RENDERER
         ===================================================================== */
      function renderLibrary() {
        const grid = document.getElementById("library-grid");
        const q = state.searchQuery.trim().toLowerCase();

        const filtered = BOOKS.filter(b => {
          const matchTrad = state.traditionFilter === "ALL" || b.tradition === state.traditionFilter;
          if (!matchTrad) return false;
          if (!q) return true;
          const inPassages = b.passages.some(p => p.title.toLowerCase().includes(q) || p.ref.toLowerCase().includes(q));
          const originName = (PLACES[b.origin]?.name || b.origin).toLowerCase();
          return (
            b.title.toLowerCase().includes(q) ||
            b.writer.toLowerCase().includes(q) ||
            b.writerNotes.toLowerCase().includes(q) ||
            b.category.toLowerCase().includes(q) ||
            originName.includes(q) ||
            inPassages
          );
        });

        document.getElementById("library-count-label").textContent = `Showing ${filtered.length} of ${BOOKS.length} Books`;

        grid.innerHTML = filtered.map(b => {
          const tr = getTradition(b.tradition);
          const originPlace = PLACES[b.origin]?.name || b.origin;
          return `
            <article class="bg-slate-900/90 border border-slate-800 hover:border-slate-600 rounded-xl p-4 flex flex-col justify-between transition shadow">
              <div>
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-slate-950 border" style="color:${tr.color}; border-color:${tr.color}55">
                    ${tr.symbol} ${b.category}
                  </span>
                  <span class="text-[11px] text-slate-400 font-mono">${b.chapters} ch • ${b.date}</span>
                </div>
                <h3 class="text-base font-bold text-white mb-1">${b.title}</h3>
                <div class="text-xs text-slate-300 mb-1">
                  <span class="text-slate-400">Writer:</span> <strong class="text-teal-300">${b.writer}</strong>
                </div>
                <p class="text-[11px] text-slate-400 mb-2.5 leading-relaxed">${b.writerNotes}</p>

                <div class="space-y-1.5 border-t border-slate-800/80 pt-2.5 mb-3">
                  <div class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Complete Passage Breakdown</div>
                  ${b.passages.map(p => `
                    <div class="text-xs bg-slate-950/70 rounded px-2 py-1.5 border border-slate-800/70">
                      <div class="flex items-center justify-between text-[11px]">
                        <span class="font-mono font-semibold text-amber-300">${p.ref}</span>
                        <span class="text-[10px] text-slate-400">📍 ${(PLACES[p.place]?.name || p.place).split(" (")[0]}</span>
                      </div>
                      <div class="text-slate-200 text-[11px] mt-0.5">${p.title}</div>
                    </div>
                  `).join("")}
                </div>
              </div>

              <div class="flex items-center justify-between pt-2 border-t border-slate-800/80">
                <span class="text-[11px] text-slate-400">Origin: <strong class="text-slate-200">${originPlace.split(" (")[0]}</strong></span>
                <button data-locate-book="${b.id}" class="px-2.5 py-1 rounded bg-teal-600/20 hover:bg-teal-600 text-teal-300 hover:text-white border border-teal-500/40 text-xs font-semibold transition">
                  🗺️ Map Journey
                </button>
              </div>
            </article>
          `;
        }).join("");

        grid.querySelectorAll("[data-locate-book]").forEach(btn => {
          btn.addEventListener("click", () => {
            jumpToBook(btn.getAttribute("data-locate-book"));
          });
        });
      }

      /* =====================================================================
         10. WORKSPACE 3: WRITER ATTRIBUTION & CANONICAL LOOM RENDERER
         ===================================================================== */
      function renderLoom() {
        const container = document.getElementById("loom-writers-table");
        const filtered = BOOKS.filter(b => state.traditionFilter === "ALL" || b.tradition === state.traditionFilter);

        container.innerHTML = filtered.map(b => {
          const tr = getTradition(b.tradition);
          const isOT = b.tradition === "OT";
          const isNT = b.tradition === "NT_GOSPEL" || b.tradition === "NT_EPISTLE" || b.tradition === "PROPHECY";
          const isDeutero = ["TOB", "JDT", "WIS", "SIR", "BAR", "1MA", "2MA", "PS151"].includes(b.id);
          const isOrthodox = isDeutero || ["3MA", "4MA", "1ES", "PMA"].includes(b.id);
          const isEthiopian = isOrthodox || ["1EN", "JUB", "MEK", "2ES", "INF"].includes(b.id);

          const badge = (yes, label) => yes
            ? `<span class="px-1.5 py-0.5 rounded bg-emerald-950/90 text-emerald-300 border border-emerald-700/50 text-[10px] font-semibold">${label}</span>`
            : `<span class="px-1.5 py-0.5 rounded bg-slate-900 text-slate-600 text-[10px]">—</span>`;

          return `
            <tr class="border-b border-slate-800/70 hover:bg-slate-800/40 transition">
              <td class="py-2.5 px-3 font-semibold text-white">
                <button data-loom-book="${b.id}" class="hover:text-teal-300 text-left flex items-center gap-1.5">
                  <span style="color:${tr.color}">${tr.symbol}</span>
                  <span>${b.title}</span>
                </button>
              </td>
              <td class="py-2.5 px-3 text-teal-300 font-medium">${b.writer}</td>
              <td class="py-2.5 px-3 text-slate-400 text-xs">${b.writerNotes}</td>
              <td class="py-2.5 px-3 text-slate-300 font-mono text-xs whitespace-nowrap">${b.date}</td>
              <td class="py-2.5 px-3 text-slate-300 text-xs">${(PLACES[b.origin]?.name || b.origin).split(" (")[0]}</td>
              <td class="py-2.5 px-3 text-center">${badge(isOT || isNT, "Prot/Masoretic")}</td>
              <td class="py-2.5 px-3 text-center">${badge(isOT || isNT || isDeutero, "Cath/LXX")}</td>
              <td class="py-2.5 px-3 text-center">${badge(isOT || isNT || isOrthodox, "E. Orthodox")}</td>
              <td class="py-2.5 px-3 text-center">${badge(isOT || isNT || isEthiopian, "Tewahedo/Coptic")}</td>
            </tr>
          `;
        }).join("");

        container.querySelectorAll("[data-loom-book]").forEach(btn => {
          btn.addEventListener("click", () => jumpToBook(btn.getAttribute("data-loom-book")));
        });
      }

      /* =====================================================================
         11. WORKSPACE 4: CROSS-TESTAMENT & APOCRYPHAL LINKS RENDERER
         ===================================================================== */
      function renderLinks() {
        const grid = document.getElementById("links-grid");
        const filtered = CROSS_LINKS.filter(l => state.linkCategory === "ALL" || l.category === state.linkCategory);

        grid.innerHTML = filtered.map(l => {
          const srcBook = BOOK_BY_ID[l.sourceBook] || BOOKS[0];
          const tgtBook = BOOK_BY_ID[l.targetBook] || BOOKS[0];
          const srcTrad = getTradition(srcBook.tradition);
          const tgtTrad = getTradition(tgtBook.tradition);
          const placeObj = PLACES[l.place];

          return `
            <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 flex flex-col justify-between shadow">
              <div>
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                  <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-teal-950 text-teal-300 border border-teal-700/50">
                    ${l.category.replace("_", " ")}
                  </span>
                  <button data-link-place="${l.place}" class="text-xs text-slate-300 hover:text-teal-300 font-medium">
                    📍 ${placeObj ? placeObj.name : l.place}
                  </button>
                </div>

                <h3 class="text-sm font-bold text-white mb-2">${l.theme}</h3>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-3">
                  <div class="p-2.5 rounded-lg bg-slate-950 border border-slate-800">
                    <div class="text-[10px] font-semibold" style="color:${srcTrad.color}">${srcTrad.symbol} ${srcBook.title}</div>
                    <div class="text-xs font-mono font-bold text-white mt-0.5">${l.sourceRef}</div>
                  </div>
                  <div class="p-2.5 rounded-lg bg-slate-950 border border-slate-800">
                    <div class="text-[10px] font-semibold" style="color:${tgtTrad.color}">${tgtTrad.symbol} ${tgtBook.title}</div>
                    <div class="text-xs font-mono font-bold text-white mt-0.5">${l.targetRef}</div>
                  </div>
                </div>

                <p class="text-xs text-slate-300 leading-relaxed">${l.note}</p>
              </div>

              <div class="flex items-center justify-end gap-2 mt-3 pt-2 border-t border-slate-800">
                <button data-link-book="${srcBook.id}" class="text-[11px] px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200">
                  Inspect ${srcBook.title.split(" (")[0]}
                </button>
                <button data-link-book="${tgtBook.id}" class="text-[11px] px-2.5 py-1 rounded bg-teal-600/20 hover:bg-teal-600 text-teal-300 hover:text-white border border-teal-500/40">
                  Map ${tgtBook.title.split(" (")[0]}
                </button>
              </div>
            </div>
          `;
        }).join("");

        grid.querySelectorAll("[data-link-book]").forEach(btn => {
          btn.addEventListener("click", () => jumpToBook(btn.getAttribute("data-link-book")));
        });
        grid.querySelectorAll("[data-link-place]").forEach(btn => {
          btn.addEventListener("click", () => {
            const pk = btn.getAttribute("data-link-place");
            switchWorkspace("journey");
            selectPlace(pk);
          });
        });
      }

      /* =====================================================================
         12. EVENT LISTENERS & CONTROLS
         ===================================================================== */
      function switchWorkspace(ws) {
        state.workspace = ws;
        document.querySelectorAll(".ws-panel").forEach(p => p.classList.add("hidden"));
        const activePanel = document.getElementById(`ws-${ws}`);
        if (activePanel) activePanel.classList.remove("hidden");

        document.querySelectorAll(".ws-tab").forEach(btn => {
          const isMatch = btn.getAttribute("data-workspace") === ws;
          btn.className = isMatch
            ? "ws-tab px-3 py-1.5 rounded-md text-xs font-semibold transition bg-teal-600 text-white shadow"
            : "ws-tab px-3 py-1.5 rounded-md text-xs font-semibold transition text-slate-300 hover:text-white hover:bg-slate-800/70";
        });

        if (ws === "journey") renderAtlas();
        if (ws === "library") renderLibrary();
        if (ws === "loom") renderLoom();
        if (ws === "links") renderLinks();
      }

      function syncTraditionButtons() {
        document.querySelectorAll(".trad-btn").forEach(b => {
          const t = b.getAttribute("data-tradition");
          if (t === state.traditionFilter) {
            b.classList.add("ring-2", "ring-teal-400");
          } else {
            b.classList.remove("ring-2", "ring-teal-400");
          }
        });
      }

      // Workspace Tab Clicks
      document.querySelectorAll(".ws-tab").forEach(btn => {
        btn.addEventListener("click", () => {
          switchWorkspace(btn.getAttribute("data-workspace"));
        });
      });

      // Tradition Filter Pills
      document.querySelectorAll(".trad-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          state.traditionFilter = btn.getAttribute("data-tradition");
          state.stepIndex = 0;
          syncTraditionButtons();
          updateJourneyUI();
          renderLibrary();
          renderLoom();
        });
      });

      // Route Layer Selector
      document.getElementById("route-group-select").addEventListener("change", (e) => {
        state.routeGroup = e.target.value;
        state.stepIndex = 0;
        updateJourneyUI();
      });

      // Step Controls
      document.getElementById("btn-prev-step").addEventListener("click", () => {
        const steps = getFilteredSteps();
        if (!steps.length) return;
        state.stepIndex = (state.stepIndex - 1 + steps.length) % steps.length;
        updateJourneyUI();
      });

      document.getElementById("btn-next-step").addEventListener("click", () => {
        const steps = getFilteredSteps();
        if (!steps.length) return;
        state.stepIndex = (state.stepIndex + 1) % steps.length;
        updateJourneyUI();
      });

      document.getElementById("step-scrubber").addEventListener("input", (e) => {
        state.stepIndex = parseInt(e.target.value, 10) || 0;
        updateJourneyUI();
      });

      // Play / Pause Auto-Advance
      const playBtn = document.getElementById("btn-play-journey");
      playBtn.addEventListener("click", () => {
        state.isPlaying = !state.isPlaying;
        if (state.isPlaying) {
          playBtn.textContent = "⏸ Pause";
          state.playTimer = setInterval(() => {
            const steps = getFilteredSteps();
            if (!steps.length) return;
            state.stepIndex = (state.stepIndex + 1) % steps.length;
            updateJourneyUI();
          }, 2600);
        } else {
          playBtn.textContent = "▶ Play Journey";
          clearInterval(state.playTimer);
        }
      });

      // 2D / 3D Globe Toggle
      const projBtn = document.getElementById("btn-toggle-projection");
      projBtn.addEventListener("click", () => {
        state.is3D = !state.is3D;
        if (state.is3D) {
          svg.on(".zoom", null);
          svg.call(globeDrag);
          mapRoot.attr("transform", null);
          projBtn.classList.add("bg-teal-700", "text-white");
        } else {
          svg.on(".drag", null);
          svg.call(zoomBehavior);
          projBtn.classList.remove("bg-teal-700", "text-white");
        }
        updateJourneyUI();
      });

      // Reset Map View
      document.getElementById("btn-reset-zoom").addEventListener("click", () => {
        state.globeRotation = [-35.2, -27.8, 0];
        svg.transition().duration(500).call(zoomBehavior.transform, d3.zoomIdentity);
        renderAtlas();
      });

      // Keyboard Arrow Navigation
      window.addEventListener("keydown", (e) => {
        if (["INPUT", "SELECT", "TEXTAREA"].includes(document.activeElement?.tagName)) return;
        if (e.key === "ArrowRight") {
          document.getElementById("btn-next-step").click();
        } else if (e.key === "ArrowLeft") {
          document.getElementById("btn-prev-step").click();
        }
      });

      // Library Search Input
      document.getElementById("library-search").addEventListener("input", (e) => {
        state.searchQuery = e.target.value;
        renderLibrary();
      });

      // Links Category Buttons
      document.querySelectorAll(".link-cat-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          state.linkCategory = btn.getAttribute("data-link-cat");
          document.querySelectorAll(".link-cat-btn").forEach(b => {
            b.className = b === btn
              ? "link-cat-btn active px-3 py-1 rounded text-xs font-semibold bg-teal-600 text-white"
              : "link-cat-btn px-3 py-1 rounded text-xs font-medium bg-slate-800 text-slate-300 hover:bg-slate-700";
          });
          renderLinks();
        });
      });

      // Vision / Colorblind Accessibility Simulator
      document.getElementById("cvd-select").addEventListener("change", (e) => {
        document.body.classList.remove("cvd-deuteranopia", "cvd-grayscale");
        if (e.target.value !== "none") {
          document.body.classList.add(e.target.value);
        }
      });

      // Initial Boot
      updateJourneyUI();
      renderLibrary();
      renderLoom();
      renderLinks();
    })();
  </script>
</body>
</html>