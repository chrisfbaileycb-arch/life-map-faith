<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Codex Geographica — Complete Biblical & Apocryphal Interactive Atlas</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://d3js.org/d3.v7.min.js"></script>
  <script src="https://unpkg.com/topojson-client@3"></script>
  <style>
    :root {
      --bg-dark: #090d16;
      --panel-bg: #111827;
      --border-col: #1f2937;
      /* Okabe-Ito Colorblind-Safe Categorical Palette */
      --col-ot: #E69F00;         /* Orange — Old Testament */
      --col-nt-gospel: #56B4E9;  /* Sky Blue — Gospels & Jesus's Ministry */
      --col-nt-epistle: #009E73; /* Bluish Green — Acts & Epistles */
      --col-apoc: #CC79A7;       /* Reddish Purple — Apocrypha / Deuterocanon / Ethiopian / Egypt */
      --col-prophecy: #F0E442;   /* Yellow — Apocalyptic & Revelation */
    }
    body {
      background-color: var(--bg-dark);
      color: #e2e8f0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      overflow-x: hidden;
    }
    .custom-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scroll::-webkit-scrollbar-track { background: #0b1120; }
    .custom-scroll::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    .custom-scroll::-webkit-scrollbar-thumb:hover { background: #475569; }
    .map-surface {
      background: radial-gradient(circle at 50% 45%, #13203d 0%, #070b14 100%);
    }
    .kbd {
      background: #1e293b;
      border: 1px solid #475569;
      border-radius: 4px;
      padding: 1px 5px;
      font-size: 0.7rem;
      font-family: monospace;
    }
    .cvd-deuteranopia { filter: saturate(0.75) hue-rotate(-18deg); }
    .cvd-grayscale { filter: grayscale(100%); }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-teal-500 selection:text-slate-950">

  <!-- TOP NAVIGATION & WORKSPACE MODES -->
  <header class="border-b border-slate-800 bg-slate-900/95 backdrop-blur sticky top-0 z-40 px-4 py-2.5">
    <div class="max-w-[1840px] mx-auto flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-teal-500/15 border border-teal-400/40 flex items-center justify-center text-teal-300 font-bold text-lg shadow-inner">
          ⊕
        </div>
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h1 class="text-base sm:text-lg font-bold tracking-tight text-white">
              Codex Geographica
            </h1>
            <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-teal-950/90 text-teal-300 border border-teal-700/50">
              84 Books • 39 OT • 27 NT • 18 Apocrypha • Step-by-Step Atlas
            </span>
          </div>
          <p class="text-xs text-slate-400">
            Cumulative Interactive Space: Every Writer, Passage Breakdown, Canonical &amp; Apocryphal Journey
          </p>
        </div>
      </div>

      <!-- Primary Workspace Mode Tabs (JOURNEY / LIBRARY / LOOM / LINKS) -->
      <nav aria-label="Workspace views" class="flex items-center gap-1 bg-slate-950 p-1 rounded-lg border border-slate-800">
        <button data-workspace="journey" class="ws-tab px-3 py-1.5 rounded-md text-xs font-semibold transition bg-teal-600 text-white shadow">
          🗺️ JOURNEY
        </button>
        <button data-workspace="library" class="ws-tab px-3 py-1.5 rounded-md text-xs font-semibold transition text-slate-300 hover:text-white hover:bg-slate-800/70">
          📖 LIBRARY (84)
        </button>
        <button data-workspace="loom" class="ws-tab px-3 py-1.5 rounded-md text-xs font-semibold transition text-slate-300 hover:text-white hover:bg-slate-800/70">
          🧵 LOOM (Writers &amp; Canon)
        </button>
        <button data-workspace="links" class="ws-tab px-3 py-1.5 rounded-md text-xs font-semibold transition text-slate-300 hover:text-white hover:bg-slate-800/70">
          🔗 LINKS (Cross-Text)
        </button>
      </nav>

      <!-- Global Tradition Filter Pills & Vision Check -->
      <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter by scriptural tradition">
        <button data-tradition="ALL" class="trad-btn active px-2.5 py-1 rounded text-xs font-semibold bg-slate-100 text-slate-900 transition">
          All (84)
        </button>
        <button data-tradition="OT" class="trad-btn px-2.5 py-1 rounded text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-amber-300 border border-amber-500/40 flex items-center gap-1 transition">
          <span>■</span> OT (39)
        </button>
        <button data-tradition="NT_GOSPEL" class="trad-btn px-2.5 py-1 rounded text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-sky-300 border border-sky-400/40 flex items-center gap-1 transition">
          <span>●</span> Gospels (4)
        </button>
        <button data-tradition="NT_EPISTLE" class="trad-btn px-2.5 py-1 rounded text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-emerald-300 border border-emerald-400/40 flex items-center gap-1 transition">
          <span>▲</span> Acts &amp; Epistles (22)
        </button>
        <button data-tradition="APOCRYPHA" class="trad-btn px-2.5 py-1 rounded text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-pink-300 border border-pink-400/40 flex items-center gap-1 transition">
          <span>◆</span> Apocrypha &amp; Egypt/Africa (18)
        </button>
        <button data-tradition="PROPHECY" class="trad-btn px-2.5 py-1 rounded text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-yellow-200 border border-yellow-400/40 flex items-center gap-1 transition">
          <span>★</span> Apocalyptic (1)
        </button>
        <select id="cvdSelect" aria-label="Color vision simulation" class="bg-slate-900 border border-slate-700 rounded px-2 py-1 text-xs text-slate-300">
          <option value="normal">Vision: Standard (Okabe-Ito)</option>
          <option value="deuteranopia">Vision: Deuteranopia Check</option>
          <option value="grayscale">Vision: Grayscale Check</option>
        </select>
      </div>
    </div>
  </header>

  <!-- =========================================================
       WORKSPACE 1: 🗺️ JOURNEY (Interactive Atlas + Inspector)
       ========================================================= -->
  <main id="ws-journey" class="flex-1 max-w-[1840px] w-full mx-auto grid grid-cols-1 lg:grid-cols-12 gap-3 p-3">
    <!-- Left Sidebar: Compact Book & Passage Selector -->
    <aside class="lg:col-span-3 flex flex-col bg-slate-900/90 border border-slate-800 rounded-xl overflow-hidden max-h-[86vh]">
      <div class="p-3 border-b border-slate-800 space-y-2">
        <div class="flex items-center justify-between">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-300">Scripture &amp; Apocrypha Catalog</h2>
          <span id="bookCountBadge" class="text-[11px] px-2 py-0.5 rounded bg-slate-800 text-teal-300 font-mono">84 books</span>
        </div>
        <input id="bookSearch" type="search" placeholder="Search book, writer (Moses, Paul, Enoch), place..."
          class="w-full bg-slate-950 border border-slate-700/80 rounded-lg px-2.5 py-1.5 text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-teal-400" />
      </div>
      <div id="bookListContainer" class="flex-1 overflow-y-auto custom-scroll divide-y divide-slate-800/60" role="listbox" aria-label="Books of the Bible and Apocrypha"></div>
    </aside>

    <!-- Center: Interactive D3 Map/Globe + Step-by-Step Scrubber -->
    <section class="lg:col-span-6 flex flex-col bg-slate-900/90 border border-slate-800 rounded-xl overflow-hidden">
      <div class="px-3 py-2 border-b border-slate-800 flex flex-wrap items-center justify-between gap-2 bg-slate-950/60">
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-xs font-semibold text-slate-400">Route Layer:</span>
          <button data-route="ALL" class="route-pill px-2 py-1 rounded text-xs font-semibold bg-teal-600 text-white">All Journeys</button>
          <button data-route="OT_PATRIARCHS" class="route-pill px-2 py-1 rounded text-xs font-medium bg-slate-800 text-amber-300 hover:bg-slate-700">OT Patriarchs &amp; Exodus</button>
          <button data-route="JESUS_CANON" class="route-pill px-2 py-1 rounded text-xs font-medium bg-slate-800 text-sky-300 hover:bg-slate-700">Gospels &amp; Galilee</button>
          <button data-route="JESUS_EGYPT_AFRICA" class="route-pill px-2 py-1 rounded text-xs font-medium bg-slate-800 text-pink-300 hover:bg-slate-700">Holy Family in Egypt &amp; Aksum</button>
          <button data-route="PAUL_ACTS" class="route-pill px-2 py-1 rounded text-xs font-medium bg-slate-800 text-emerald-300 hover:bg-slate-700">Acts &amp; Apostolic Missions</button>
        </div>
        <div class="flex items-center gap-1.5">
          <button id="toggleProjectionBtn" class="px-2.5 py-1 rounded text-xs font-medium bg-slate-800 hover:bg-slate-700 text-teal-300 border border-teal-500/30">
            🌐 2D Atlas / 3D Globe
          </button>
          <button id="resetZoomBtn" class="px-2 py-1 rounded text-xs bg-slate-800 hover:bg-slate-700 text-slate-300">
            Reset View
          </button>
        </div>
      </div>

      <!-- SVG Map Viewport -->
      <div class="relative flex-1 min-h-[410px] map-surface select-none overflow-hidden">
        <svg id="atlasSvg" class="w-full h-full block" role="img" aria-label="Interactive geospatial map of Biblical, Egyptian, African, and Near Eastern journeys"></svg>

        <!-- Floating Active Step Banner -->
        <div class="absolute top-3 left-3 right-3 sm:right-auto sm:max-w-md bg-slate-950/90 backdrop-blur-md border border-slate-700/80 rounded-lg p-2.5 shadow-xl pointer-events-none">
          <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-wider text-teal-300">
            <span id="stepBadge">STEP 1 / 36</span>
            <span>•</span>
            <span id="stepEpoch">PATRIARCHAL AGE</span>
          </div>
          <h3 id="stepTitle" class="text-sm font-bold text-white mt-0.5">Ur of the Chaldees to Harran &amp; Canaan</h3>
          <p id="stepNarrative" class="text-xs text-slate-300 mt-1 leading-relaxed">
            Abram journeys from Ur up the Mesopotamian river corridor to Harran, then south through Shechem, Bethel, Hebron, and into Egypt during famine.
          </p>
          <div class="mt-1.5 flex flex-wrap items-center gap-2 text-[11px] text-slate-400">
            <span id="stepScriptureRef" class="px-1.5 py-0.5 rounded bg-slate-800 text-amber-300 font-mono">Genesis 11:31–12:20</span>
            <span id="stepWriterRef">Writer: Moses (Trad. / Pentateuchal sources)</span>
          </div>
        </div>

        <!-- Map Legend -->
        <div class="absolute bottom-2.5 left-2.5 bg-slate-950/90 border border-slate-800 rounded-lg px-2.5 py-1.5 text-[11px] flex flex-wrap items-center gap-3">
          <span class="flex items-center gap-1 text-amber-300">■ OT Route</span>
          <span class="flex items-center gap-1 text-sky-300">● Gospel Ministry</span>
          <span class="flex items-center gap-1 text-pink-300">◆ Egypt &amp; Africa Apocrypha</span>
          <span class="flex items-center gap-1 text-emerald-300">▲ Apostolic &amp; Epistles</span>
        </div>
      </div>

      <!-- Step-by-Step Chronological Playback Bar -->
      <div class="p-3 border-t border-slate-800 bg-slate-950/90 space-y-2">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-1.5">
            <button id="prevStepBtn" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-200">◀ Prev</button>
            <button id="playPauseBtn" class="px-3 py-1 rounded bg-teal-600 hover:bg-teal-500 text-xs font-semibold text-white">▶ Play Journey</button>
            <button id="nextStepBtn" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-200">Next ▶</button>
          </div>
          <div class="text-xs text-slate-400 flex items-center gap-2">
            <span>Keys: <kbd class="kbd">←</kbd> <kbd class="kbd">→</kbd> step</span>
            <span id="scrubberReadout" class="font-mono text-teal-300">Step 1 of 36</span>
          </div>
        </div>
        <input id="stepSlider" type="range" min="0" max="35" value="0" aria-label="Chronological journey step scrubber"
          class="w-full accent-teal-400 cursor-pointer h-1.5 bg-slate-800 rounded-lg" />
      </div>
    </section>

    <!-- Right Sidebar: Deep Passage, Writer & Cross-Link Inspector -->
    <aside class="lg:col-span-3 flex flex-col bg-slate-900/90 border border-slate-800 rounded-xl overflow-hidden max-h-[86vh]">
      <div id="bookInspector" class="flex-1 overflow-y-auto custom-scroll p-3.5 space-y-4"></div>
    </aside>
  </main>

  <!-- =========================================================
       WORKSPACE 2: 📖 LIBRARY (Full 84-Book Searchable Matrix)
       ========================================================= -->
  <section id="ws-library" class="hidden flex-1 max-w-[1840px] w-full mx-auto p-3 space-y-3">
    <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-base font-bold text-white">Complete 84-Book Canonical, Deuterocanonical &amp; Apocryphal Library</h2>
        <p class="text-xs text-slate-400">Every book of the Old Testament (39), New Testament (27), and Apocrypha / Infancy / Ethiopian traditions (18) with every division, passage range, and writer attribution.</p>
      </div>
      <input id="librarySearchInput" type="search" placeholder="Filter 84 books by title, writer, passage, or city..."
        class="w-full sm:w-80 bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-100" />
    </div>
    <div id="libraryGrid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3"></div>
  </section>

  <!-- =========================================================
       WORKSPACE 3: 🧵 LOOM (Perceptually Honest Bar Charts)
       ========================================================= -->
  <section id="ws-loom" class="hidden flex-1 max-w-[1840px] w-full mx-auto p-3 space-y-3">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
      <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4">
        <h2 class="text-sm font-bold text-white">Chapters by Scriptural Tradition (Sorted Horizontal Bars, Zero-Baseline)</h2>
        <p class="text-xs text-slate-400 mb-3">Encoded by horizontal length from a strict zero baseline paired with Okabe-Ito colorblind-safe hues and geometric symbols.</p>
        <div id="chartTraditionBars" class="space-y-2.5"></div>
      </div>
      <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4">
        <h2 class="text-sm font-bold text-white">Writer &amp; Scribal Attribution Across All 84 Books</h2>
        <p class="text-xs text-slate-400 mb-3">Comparing book and chapter volume across traditional and historical-critical writer cohorts.</p>
        <div id="chartWriterBars" class="space-y-2 max-h-[360px] overflow-y-auto custom-scroll pr-2"></div>
      </div>
    </div>
    <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4">
      <h2 class="text-sm font-bold text-white mb-1">Chronological Composition &amp; Journey Density Timeline (1500 BCE – 200 CE)</h2>
      <p class="text-xs text-slate-400 mb-3">Click any book bar below to jump directly to its passage breakdown and geospatial pin on the Journey map.</p>
      <div id="loomTimelineList" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-7 gap-1.5"></div>
    </div>
  </section>

  <!-- =========================================================
       WORKSPACE 4: 🔗 LINKS (Prophecy, Fulfillment & Apocrypha)
       ========================================================= -->
  <section id="ws-links" class="hidden flex-1 max-w-[1840px] w-full mx-auto p-3 space-y-3">
    <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4">
      <h2 class="text-base font-bold text-white">Intertextual Connections: Old Testament, New Testament &amp; Apocrypha/Egyptian Traditions</h2>
      <p class="text-xs text-slate-400">Explore how Old Testament passages, Second Temple / Ethiopian Apocrypha (1 Enoch, Jubilees, Infancy Gospels, Kebra Nagast), and New Testament passages cite and fulfill one another geographically.</p>
    </div>
    <div id="linksContainer" class="grid grid-cols-1 md:grid-cols-2 gap-3"></div>
  </section>

  <script>
    (function () {
      "use strict";

      /* =====================================================================
         1. COLORBLIND-SAFE TRADITION METADATA (Okabe-Ito + Shape Redundancy)
         Both TRADITIONS and TRADITION_META point to the exact same object so
         any lookup succeeds without ReferenceError.
         ===================================================================== */
      const TRADITION_META = {
        OT: {
          id: "OT",
          label: "Old Testament (Law, History, Poetry, Prophets)",
          short: "Old Testament",
          color: "#E69F00",
          symbol: "■",
          badge: "bg-amber-950/90 text-amber-300 border-amber-500/40"
        },
        NT_GOSPEL: {
          id: "NT_GOSPEL",
          label: "New Testament Gospels (Life & Ministry of Jesus)",
          short: "NT Gospel",
          color: "#56B4E9",
          symbol: "●",
          badge: "bg-sky-950/90 text-sky-300 border-sky-400/40"
        },
        NT_EPISTLE: {
          id: "NT_EPISTLE",
          label: "Acts & Epistles (Pauline & General Letters)",
          short: "Acts & Epistles",
          color: "#009E73",
          symbol: "▲",
          badge: "bg-emerald-950/90 text-emerald-300 border-emerald-400/40"
        },
        APOCRYPHA: {
          id: "APOCRYPHA",
          label: "Apocrypha, Deuterocanon, Ethiopian & Egyptian Infancy",
          short: "Apocrypha & Africa",
          color: "#CC79A7",
          symbol: "◆",
          badge: "bg-pink-950/90 text-pink-300 border-pink-400/40"
        },
        PROPHECY: {
          id: "PROPHECY",
          label: "Apocalyptic Prophecy (Revelation / Apocalypse)",
          short: "Apocalyptic",
          color: "#F0E442",
          symbol: "★",
          badge: "bg-yellow-950/90 text-yellow-200 border-yellow-400/40"
        }
      };
      const TRADITIONS = TRADITION_META;
      window.TRADITION_META = TRADITION_META;
      window.TRADITIONS = TRADITIONS;

      function getTradition(key) {
        return TRADITION_META[key] || TRADITION_META.OT;
      }

      /* =====================================================================
         2. GEOSPATIAL PLACES DICTIONARY (Near East, Egypt, Ethiopia/Aksum, Med)
         ===================================================================== */
      const PLACES = {
        Ur: { name: "Ur of the Chaldees", coords: [46.103, 30.962], region: "Mesopotamia" },
        Harran: { name: "Harran", coords: [39.031, 36.864], region: "Upper Mesopotamia" },
        Babylon: { name: "Babylon", coords: [44.421, 32.536], region: "Mesopotamia" },
        Nineveh: { name: "Nineveh (Mosul)", coords: [43.152, 36.359], region: "Assyria" },
        Susa: { name: "Susa (Shushan)", coords: [48.243, 32.189], region: "Persia / Elam" },
        Damascus: { name: "Damascus", coords: [36.291, 33.513], region: "Syria" },
        Antioch: { name: "Antioch on the Orontes", coords: [36.161, 36.202], region: "Syria" },
        Tarsus: { name: "Tarsus", coords: [34.895, 36.916], region: "Cilicia" },
        Shechem: { name: "Shechem (Mt. Gerizim)", coords: [35.278, 32.214], region: "Samaria" },
        Nazareth: { name: "Nazareth", coords: [35.303, 32.702], region: "Galilee" },
        Capernaum: { name: "Capernaum (Sea of Galilee)", coords: [35.575, 32.881], region: "Galilee" },
        Cana: { name: "Cana of Galilee", coords: [35.335, 32.747], region: "Galilee" },
        CaesareaPhilippi: { name: "Caesarea Philippi (Mt. Hermon)", coords: [35.694, 33.248], region: "Gaulanitis" },
        Tyre: { name: "Tyre & Sidon", coords: [35.196, 33.271], region: "Phoenicia" },
        Caesarea: { name: "Caesarea Maritima", coords: [34.891, 32.501], region: "Sharon Coast" },
        Joppa: { name: "Joppa (Jaffa)", coords: [34.751, 32.054], region: "Judean Coast" },
        Jericho: { name: "Jericho & Jordan Ford", coords: [35.444, 31.866], region: "Jordan Valley" },
        Qumran: { name: "Qumran (Dead Sea Caves)", coords: [35.459, 31.741], region: "Judean Desert" },
        Jerusalem: { name: "Jerusalem (Zion)", coords: [35.235, 31.778], region: "Judea" },
        Bethlehem: { name: "Bethlehem", coords: [35.202, 31.705], region: "Judea" },
        Hebron: { name: "Hebron (Mamre)", coords: [35.109, 31.524], region: "Judea" },
        Gaza: { name: "Gaza (Way of the Sea)", coords: [34.466, 31.501], region: "Philistia" },
        Sinai: { name: "Mount Sinai (Horeb)", coords: [33.975, 28.539], region: "Sinai Peninsula" },
        Pelusium: { name: "Pelusium / Farama (Sinai Gate)", coords: [32.548, 31.042], region: "East Nile Delta" },
        Bubastis: { name: "Tel Basta (Bubastis)", coords: [31.516, 30.573], region: "Nile Delta, Egypt" },
        Heliopolis: { name: "Matariya / Heliopolis (Sycamore Tree)", coords: [31.318, 30.129], region: "Cairo, Egypt" },
        Memphis: { name: "Old Cairo (Babylon-in-Egypt / Memphis)", coords: [31.231, 30.006], region: "Lower Egypt" },
        Alexandria: { name: "Alexandria", coords: [29.918, 31.201], region: "Mediterranean Egypt" },
        Oxyrhynchus: { name: "Al-Bahnasa (Oxyrhynchus)", coords: [30.656, 28.537], region: "Middle Egypt" },
        Hermopolis: { name: "Al-Ashmunayn (Hermopolis Magna)", coords: [30.803, 27.781], region: "Middle Egypt" },
        Muharraq: { name: "Deir al-Muharraq (Qusqam — 6-Month Sanctuary)", coords: [30.979, 27.382], region: "Assiut / Upper Egypt" },
        NagHammadi: { name: "Nag Hammadi (Chenoboskion)", coords: [32.241, 26.049], region: "Upper Egypt" },
        Syene: { name: "Syene / Elephantine (Aswan)", coords: [32.887, 24.088], region: "Upper Egypt Frontier" },
        Meroe: { name: "Meroë (Kush / Nubia)", coords: [33.748, 16.938], region: "Kush / Sudan" },
        Aksum: { name: "Aksum (St. Mary of Zion / Ethiopian Canon)", coords: [38.716, 14.131], region: "Ethiopia (Highlands)" },
        Cyrene: { name: "Cyrene", coords: [21.856, 32.825], region: "North Africa (Libya)" },
        Cyprus: { name: "Salamis & Paphos (Cyprus)", coords: [33.901, 35.185], region: "Eastern Mediterranean" },
        Iconium: { name: "Iconium & Lystra (Galatia)", coords: [32.484, 37.871], region: "Asia Minor" },
