      ["PHM","Philemon","NT_EPISTLE",1,"Paul & Timothy","Undisputed personal prison letter regarding Onesimus","c. 60–62 CE","rome","All Christian Canons",[["1:1–25","Appeal to Receive Onesimus No Longer as a Slave, but a Beloved Brother"]]],
      ["HEB","Hebrews","NT_EPISTLE",13,"Anonymous (Paul, Barnabas, Apollos, or Priscilla)","Hellenistic Jewish-Christian homily","c. 60–69 CE","rome","All Christian Canons",[["1–4","Christ Superior to Angels & Moses; Sabbath Rest"],["5–10","High Priest After the Order of Melchizedek & Better Sanctuary"],["11–13","Hall of Faith (Ch. 11), Mount Zion & Benediction"]]],
      ["JAS","James","NT_EPISTLE",5,"James the Just (Brother of Jesus)","Leader of the Jerusalem Mother Church","c. 45–62 CE","jerusalem","All Christian Canons",[["1–2","Trials, Doers of the Word & Faith Without Works is Dead"],["3–5","Taming the Tongue, Condemning Hoarded Wealth & Prayer of Faith"]]],
      ["1PE","1 Peter","NT_EPISTLE",5,"Peter the Apostle (scribed by Silvanus)","Circular letter from Rome ('Babylon') to Asia Minor","c. 62–64 CE","rome","All Christian Canons",[["1–2:10","Living Hope, Royal Priesthood & Cornerstone"],["2:11–5","Suffering as Exiles & Shepherding the Flock"]]],
      ["2PE","2 Peter","NT_EPISTLE",3,"Simon Peter","Petrine testament parallel to Jude","c. 65–90 CE","rome","All Christian Canons",[["1","Partakers of the Divine Nature & Transfiguration Eyewitness"],["2–3","False Teachers & Promise of New Heavens and New Earth"]]],
      ["1JN","1 John","NT_EPISTLE",5,"John the Elder / Apostle","Johannine pastoral homily from Ephesus","c. 90–95 CE","ephesus","All Christian Canons",[["1–2","God is Light & Advocate with the Father"],["3–5","God is Love: Testing the Spirits & Overcoming the World"]]],
      ["2JN","2 John","NT_EPISTLE",1,"The Elder (John)","Brief letter to the Elect Lady","c. 90–95 CE","ephesus","All Christian Canons",[["1:1–13","Walking in Truth and Love; Guarding Against Docetism"]]],
      ["3JN","3 John","NT_EPISTLE",1,"The Elder (John)","Personal letter to Gaius","c. 90–95 CE","ephesus","All Christian Canons",[["1:1–15","Hospitality to Travelling Missionaries vs. Diotrephes"]]],
      ["JUD","Jude","NT_EPISTLE",1,"Jude (Brother of James & Jesus)","Jewish-Christian epistle quoting 1 Enoch 1:9","c. 65–80 CE","jerusalem","All Christian Canons",[["1:1–25","Contending for the Faith, Fallen Angels, Enoch's Prophecy & Doxology"]]],
      ["REV","Revelation (Apocalypse)","PROPHECY",22,"John of Patmos","Apocalyptic prophetic letter to Seven Churches","c. 95 CE","patmos","All Christian Canons",[["1–3","Vision of the Risen Christ & Letters to Seven Churches of Asia"],["4–11","Throne Room in Heaven, Seven Seals & Seven Trumpets"],["12–18","Woman & Dragon, Beasts, Seven Bowls & Fall of Babylon"],["19–22","Rider on the White Horse, New Jerusalem & Tree of Life"]]],

      // === APOCRYPHA / DEUTEROCANON / ETHIOPIAN / EARLY TEXTS (18) ===
      ["TOB","Tobit","APOCRYPHA",14,"Tobit / Diaspora Scribe","Aramaic/Hebrew novella found at Qumran (4Q196–200)","c. 225–175 BCE","nineveh","Catholic / Orthodox / Ethiopian",[["1–3","Tobit's Almsgiving in Nineveh & Sarah's Plight in Ecbatana"],["4–9","Tobias & Archangel Raphael Journey to Media"],["10–14","Healing of Tobit's Blindness, Raphael's Reveal & Hymn for Jerusalem"]]],
      ["JDT","Judith","APOCRYPHA",16,"Palestinian Jewish Author","Hasmonean patriotic resistance narrative","c. 150–100 BCE","shechem","Catholic / Orthodox / Ethiopian",[["1–7","Nebuchadnezzar's General Holofernes Besieges Bethulia"],["8–13","Judith's Prayer, Entry into the Assyrian Camp & Beheading of Holofernes"],["14–16","Assyrian Rout & Judith's Thanksgiving Victory Hymn"]]],
      ["WIS","Wisdom of Solomon","APOCRYPHA",19,"Alexandrian Jewish Sage","Hellenistic Jewish philosophical & sapiential work","c. 50 BCE","alexandria","Catholic / Orthodox / Ethiopian",[["1–5","Destiny of the Righteous: 'The Souls of the Just Are in the Hand of God'"],["6–9","Praise of Lady Wisdom as Breath of God's Power"],["10–19","Wisdom's Saving Work from Adam through the Exodus Plagues"]]],
      ["SIR","Sirach (Ecclesiasticus)","APOCRYPHA",51,"Jesus ben Sira (trans. by grandson in Egypt)","Jerusalem scribe (180 BCE) translated in Alexandria (132 BCE)","c. 180 BCE","jerusalem","Catholic / Orthodox / Ethiopian",[["1–23","Fear of the Lord, Practical Ethics & Speech"],["24–43","Torah as Embodied Wisdom & Glory of God in Creation"],["44–51","Praise of the Ancestors ('Let Us Now Praise Famous Men')"]]],
      ["BAR","Baruch (with Letter of Jeremiah)","APOCRYPHA",6,"Baruch ben Neriah (Trad.)","Composite liturgical confession & anti-idol satire","c. 200–100 BCE","babylon","Catholic / Orthodox / Ethiopian",[["1–3:8","Exiles' Prayer of Confession Sent from Babylon to Jerusalem"],["3:9–5:9","Poem on Wisdom & Consolation of Zion"],["6","Letter of Jeremiah: Satire Against Babylonian Idols"]]],
      ["1MA","1 Maccabees","APOCRYPHA",16,"Judean Court Historian","Hebrew chronicle of the Hasmonean revolt","c. 100 BCE","jerusalem","Catholic / Orthodox / Ethiopian",[["1–2","Antiochus Epiphanes' Desecration & Mattathias' Revolt at Modein"],["3–9","Judas Maccabeus' Battles, Cleansing of Temple (Hanukkah) & Roman Treaty"],["10–16","High Priesthoods of Jonathan and Simon"]]],
      ["2MA","2 Maccabees","APOCRYPHA",15,"Jason of Cyrene (Epitomist)","Diaspora Greek theological history","c. 124 BCE","alexandria","Catholic / Orthodox / Ethiopian",[["1–7","Heliodorus in the Temple & Martyrdom of the Mother and Seven Sons (Resurrection Hope)"],["8–15","Nicanor's Defeat, Prayers for the Dead & Judas' Victory"]]],
      ["1ES","1 Esdras (3 Esdras)","APOCRYPHA",9,"Septuagint Chronicler","Greek compilation of 2 Chr 35–36, Ezra, and Neh 8","c. 150 BCE","alexandria","Orthodox / LXX",[["1–2","Josiah's Passover, Exile & Decree of Cyrus"],["3–4","Contest of the Three Bodyguards: 'Truth Is Great and Strongest of All'"],["5–9","Zerubbabel's Return & Ezra's Reading of the Law"]]],
      ["2ES","2 Esdras (4 Ezra)","APOCRYPHA",16,"Salathiel / Ezra Apocalypse","Jewish apocalypse after 70 CE with Christian framework","c. 95–100 CE","babylon","Slavonic Orthodox / Ethiopian (Izra Sutuel)",[["1–2","Fifth Ezra: Christian Prologue"],["3–10","Seven Visions of Ezra: Theodicy, Mourning Woman Transformed into Zion"],["11–14","Eagle Vision, Son of Man from the Sea & Dictation of 94 Books (24 Public + 70 Secret)"]]],
      ["PR_MAN","Prayer of Manasseh","APOCRYPHA",1,"King Manasseh (Trad.)","Penitential psalm expanding 2 Chronicles 33:12–19","c. 200–100 BCE","babylon","Orthodox / Ethiopian / LXX Odes",[["1:1–15","Confession of Sins More Numerous Than the Sands of the Sea & Appeal to Boundless Mercy"]]],
      ["PS151","Psalm 151","APOCRYPHA",1,"David (attested in 11QPs-a at Qumran)","Hebrew autobiographical psalm on slaying Goliath","c. 300–100 BCE","qumran","Orthodox / LXX / Dead Sea Scrolls",[["1:1–7","Smallest Among My Brothers, Shepherd's Lyre, Anointing by Samuel & Defeat of the Philistine"]]],
      ["3MA","3 Maccabees","APOCRYPHA",7,"Alexandrian Jewish Historian","Account of Egyptian Jewry under Ptolemy IV Philopator","c. 100–50 BCE","alexandria","Eastern Orthodox",[["1–3","Ptolemy IV Barred from the Jerusalem Sanctuary & Persecution of Egyptian Jews"],["4–7","Deliverance in the Alexandrian Hippodrome from 500 Intoxicated Elephants"]]],
      ["4MA","4 Maccabees","APOCRYPHA",18,"Hellenistic Jewish Philosopher-Orator","Philosophical encomium on devout reason mastering passions","c. 20–54 CE","antioch","Georgian / Greek Orthodox Appendix",[["1–3","Philosophical Thesis: Pious Reason Is Sovereign Over the Emotions"],["4–18","Martyrdoms of Eleazar, the Seven Brothers, and Their Mother"]]],
      ["1EN","1 Enoch (Book of Enoch)","APOCRYPHA",108,"Enoch (Seventh from Adam)","Composite Aramaic (Qumran 4Q201–212) preserved fully in Ge'ez","c. 300–100 BCE","aksum","Ethiopian & Eritrean Orthodox Tewahedo Canon",[["1–36","Book of the Watchers: Fallen Angels on Mt Hermon & Enoch's Cosmic Journeys"],["37–71","Similitudes (Parables) of Enoch: The Messianic Son of Man & Ancient of Days"],["72–82","Astronomical Book: Solar & Lunar Luminaries"],["83–90","Book of Dream Visions: The Animal Apocalypse"],["91–108","Epistle of Enoch, Apocalypse of Weeks & Birth of Noah"]]],
      ["JUB","Jubilees (Lesser Genesis)","APOCRYPHA",50,"Moses & Angel of the Presence","Rewritten Genesis–Exodus organized in 49-year Jubilee cycles (Qumran 4Q216)","c. 160–150 BCE","qumran","Ethiopian & Eritrean Orthodox Tewahedo Canon",[["1–10","Angel Dictates to Moses on Sinai; Creation to Noah's Division of the Earth"],["11–23","Abraham's Youth in Ur, Rejection of Idols & Solar 364-Day Calendar"],["24–45","Jacob, Levi's Priesthood & Joseph in Egypt"],["46–50","Bondage in Egypt, Passover & Sabbath Jubilee Laws"]]],
      ["1MEK","1–3 Meqabyan (Ethiopian Maccabees)","APOCRYPHA",36,"Ethiopian Tewahedo Chronicler","Distinct Ge'ez theological narratives of resistance to tyranny","c. 1st–4th c. CE","aksum","Ethiopian & Eritrean Orthodox Tewahedo Canon",[["1 Meq 1–36","Martyrdom of Abya, Seela &antos Under Tsarapion; Discourse on Resurrection"],["2 Meq 1–21","Moabite King Mantikarus Repents Before the God of Israel"],["3 Meq 1–10","Theological Meditations on Satan's Fall, Job & Deliverance"]]],
      ["GTH","Gospel of Thomas (Oxyrhynchus / Nag Hammadi)","APOCRYPHA",1,"Didymos Judas Thomas (Trad.)","114 sayings (Logia) in Greek papyri (P.Oxy 1, 654, 655) & Coptic Codex II","c. 60–140 CE","oxyrhynchus","Non-Canonical / Early Sayings Tradition",[["Logia 1–39","Prologue ('Whoever Finds the Interpretation of These Sayings') & Parables of the Sower/Mustard Seed"],["Logia 40–79","Sayings on the Twin, Light Within & Kingdom Spread Upon the Earth"],["Logia 80–114","Parables of the Lost Sheep, Pearl & Hidden Treasure"]]],
      ["INF_EG","Infancy Traditions & Holy Family in Egypt","APOCRYPHA",25,"James / Matthew / Theophilus of Alexandria","Protoevangelium of James, Arabic Infancy Gospel & Vision of Theophilus","c. 150–400 CE","muharraq","Liturgical / Coptic & Ethiopian Tradition",[["Ch. 1–9","Flight from Bethlehem via Gaza and Pelusium into the Nile Delta"],["Ch. 10–18","Balsam Tree at Matariyyah (Heliopolis), Bahnasa (Oxyrhynchus) & Falling Idols (Isaiah 19:1)"],["Ch. 19–25","Six Months at Qusqam (Deir el-Muharraq — First Consecrated Altar) & Return to Nazareth"]]]
    ];

    const BOOKS = RAW_BOOKS.map(b => ({
      id: b[0],
      title: b[1],
      tradition: b[2],
      chapters: b[3],
      writerTrad: b[4],
      writerSch: b[5],
      date: b[6],
      placeId: b[7],
      canon: b[8],
      passages: b[9].map(p => ({ range: p[0], summary: p[1] }))
    }));

    // 4. 36 CHRONOLOGICAL & GEOGRAPHICAL JOURNEY STEPS (Full Arc)
    const JOURNEY_STEPS = [
      { step: 1, era: "Primeval & Patriarchs", date: "c. 2000 BCE", title: "Ur of the Chaldees to Harran: Abraham's Call", from: "ur", to: "harran", tradition: "OT", books: ["GEN","JUB"], ref: "Genesis 11:31–12:3; Jubilees 12", summary: "Terah and Abram depart Ur along the Euphrates crescent to Harran, where YHWH calls Abram to become a blessing to all families of the earth." },
      { step: 2, era: "Patriarchs", date: "c. 1950 BCE", title: "Canaan Altar Trail: Shechem, Bethel & Hebron", from: "harran", to: "hebron", tradition: "OT", books: ["GEN"], ref: "Genesis 12:6–13:18", summary: "Abram enters Canaan, builds altars at the Oak of Moreh in Shechem and Bethel, and settles by the Oaks of Mamre in Hebron." },
      { step: 3, era: "Patriarchs", date: "c. 1875 BCE", title: "Joseph Sold into Egypt & Israel's Descent to Goshen", from: "hebron", to: "pelusium", tradition: "OT", books: ["GEN","JUB"], ref: "Genesis 37–50", summary: "Sold by his brothers, Joseph rises to vizier in Egypt and welcomes Jacob's household of seventy souls into the fertile eastern Delta of Goshen." },
      { step: 4, era: "Exodus & Torah", date: "c. 1446 BCE", title: "The Exodus & Covenant at Mount Sinai", from: "pelusium", to: "sinai", tradition: "OT", books: ["EXO","LEV","NUM","JUB"], ref: "Exodus 12–24; Leviticus 1–27", summary: "Delivered through the Red Sea, Israel receives the Ten Commandments, the Book of the Covenant, and the Tabernacle blueprint at Mount Sinai." },
      { step: 5, era: "Wilderness & Conquest", date: "c. 1406 BCE", title: "Plains of Moab, Crossing the Jordan & Jericho", from: "sinai", to: "jericho", tradition: "OT", books: ["DEU","JOS"], ref: "Deuteronomy 34; Joshua 1–6", summary: "After Moses' final addresses on Mount Nebo, Joshua leads Israel across the Jordan to Jericho and renews the covenant at Shechem." },
      { step: 6, era: "Judges & Early Monarchy", date: "c. 1100–1010 BCE", title: "Shiloh Tabernacle, Bethlehem & Samuel's Anointing", from: "shiloh", to: "bethlehem", tradition: "OT", books: ["JDG","RUT","1SA","PS151"], ref: "Ruth 1–4; 1 Samuel 1–16; Psalm 151", summary: "From the Shiloh sanctuary to the barley fields of Bethlehem, Ruth's lineage leads to Samuel anointing the shepherd David." },
      { step: 7, era: "United Monarchy", date: "c. 1000–960 BCE", title: "David Captures Zion & Solomon Builds the First Temple", from: "hebron", to: "jerusalem", tradition: "OT", books: ["2SA","1KI","1CH","2CH","PSA","PRO","ECC","SNG"], ref: "2 Samuel 5–7; 1 Kings 6–8", summary: "David establishes Jerusalem as royal and liturgical capital; Solomon constructs the First Temple and flourishes in wisdom literature." },
      { step: 8, era: "Assyrian Crisis", date: "760–722 BCE", title: "Prophets of Israel & Nineveh: Jonah, Amos, Hosea & Fall of Samaria", from: "shechem", to: "nineveh", tradition: "OT", books: ["JON","AMO","HOS","2KI","NAH","TOB"], ref: "Jonah 1–4; 2 Kings 17; Tobit 1", summary: "Amos and Hosea warn the Northern Kingdom; Jonah preaches in Nineveh; Assyria exiles the ten northern tribes (setting the stage for Tobit)." },
      { step: 9, era: "Judean Prophets", date: "740–605 BCE", title: "Isaiah, Micah, Zephaniah & Habakkuk in Jerusalem", from: "jerusalem", to: "bethlehem", tradition: "OT", books: ["ISA","MIC","ZEP","HAB","JOL"], ref: "Isaiah 6–9, 40–55; Micah 5:2; Habakkuk 2:4", summary: "Jerusalem's prophets proclaim the Immanuel promise, the Bethlehem ruler, and that 'the righteous shall live by his faith.'" },
      { step: 10, era: "Babylonian Exile", date: "597–586 BCE", title: "Fall of Jerusalem & Exile by the Rivers of Babylon", from: "jerusalem", to: "babylon", tradition: "OT", books: ["JER","LAM","EZK","DAN","OBA","BAR","PR_MAN"], ref: "Jeremiah 29–31; Ezekiel 1, 37; Daniel 1–7", summary: "Nebuchadnezzar destroys the First Temple. By the Kebar Canal, Ezekiel sees the Chariot-Throne and Dry Bones while Daniel serves in the Babylonian court." },
      { step: 11, era: "Persian Period & Return", date: "538–430 BCE", title: "Susa & Decree of Cyrus: Zerubbabel, Ezra, Nehemiah & Esther", from: "susa", to: "jerusalem", tradition: "OT", books: ["EZR","NEH","EST","HAG","ZEC","MAL","1ES"], ref: "Ezra 1–10; Nehemiah 1–8; Esther 4:14", summary: "While Esther saves her people in Persian Susa, returning exiles rebuild the Second Temple and Jerusalem's walls under Ezra and Nehemiah." },
      { step: 12, era: "Second Temple & Qumran", date: "c. 300–150 BCE", title: "Enochic Watchers on Mt Hermon & Qumran Dead Sea Scrolls", from: "damascus", to: "qumran", tradition: "APOCRYPHA", books: ["1EN","JUB","SIR","PS151"], ref: "1 Enoch 6–16; Jubilees 1; Sirach 24", summary: "Aramaic Enochic visions set at Mount Hermon and the Book of Jubilees are copied by the Dead Sea community at Qumran alongside Hebrew Ben Sira." },
      { step: 13, era: "Hellenistic & Maccabean Era", date: "167–50 BCE", title: "Maccabean Revolt in Judea & Septuagint Wisdom in Alexandria", from: "jerusalem", to: "alexandria", tradition: "APOCRYPHA", books: ["1MA","2MA","3MA","JDT","WIS"], ref: "1 Maccabees 4; Wisdom of Solomon 7", summary: "The Maccabees rededicate the Jerusalem Temple, while Alexandrian Jewish scholars compose the Wisdom of Solomon and translate the Septuagint." },
      { step: 14, era: "Gospels: Nativity", date: "c. 6–4 BCE", title: "Annunciation in Nazareth to the Nativity in Bethlehem", from: "nazareth", to: "bethlehem", tradition: "NT_GOSPEL", books: ["MAT","LUK"], ref: "Luke 1:26–2:20; Matthew 1:18–2:12", summary: "Mary and Joseph travel from Nazareth of Galilee to David's city of Bethlehem, where Jesus is born and visited by shepherds and eastern Magi." },
      { step: 15, era: "Holy Family in Egypt", date: "c. 4 BCE", title: "Flight into Egypt: Bethlehem via Gaza & Pelusium to Heliopolis", from: "bethlehem", to: "heliopolis", tradition: "APOCRYPHA", books: ["MAT","ISA","INF_EG"], ref: "Matthew 2:13–15; Isaiah 19:1; Infancy Traditions", summary: "Warned in a dream, Joseph takes Mary and the child Jesus across northern Sinai (Pelusium) to Matariyyah/Heliopolis near modern Cairo." },
      { step: 16, era: "Holy Family in Egypt", date: "c. 4–3 BCE", title: "Up the Nile: Bahnasa (Oxyrhynchus) to Deir el-Muharraq (Qusqam)", from: "heliopolis", to: "muharraq", tradition: "APOCRYPHA", books: ["INF_EG","GTH"], ref: "Vision of Theophilus; Matthew 2:15", summary: "The Holy Family sails south along the Nile through Bahnasa (Oxyrhynchus, later site of the Greek Thomas papyri) to Mount Qusqam (Deir el-Muharraq) in Upper Egypt." },
      { step: 17, era: "Holy Family Return", date: "c. 2 BCE", title: "Out of Egypt I Called My Son: Return to Nazareth", from: "muharraq", to: "nazareth", tradition: "NT_GOSPEL", books: ["MAT","HOS","INF_EG"], ref: "Matthew 2:19–23; Hosea 11:1", summary: "After Herod's death, the Holy Family returns from Upper Egypt to settle in Nazareth of Galilee, fulfilling Hosea's prophecy." },
      { step: 18, era: "Gospels: Baptism", date: "c. 27 CE", title: "Baptism in the Jordan & Temptation in the Judean Wilderness", from: "nazareth", to: "jericho", tradition: "NT_GOSPEL", books: ["MAT","MRK","LUK","JHN"], ref: "Matthew 3:13–4:11; John 1:29–34", summary: "John the Baptist baptizes Jesus at Bethany beyond the Jordan; Jesus fasts forty days in the wilderness near Jericho." },
      { step: 19, era: "Gospels: Galilee", date: "c. 28–29 CE", title: "Capernaum Ministry: Sermon on the Mount & Sea of Galilee Miracles", from: "nazareth", to: "capernaum", tradition: "NT_GOSPEL", books: ["MAT","MRK","LUK","JHN"], ref: "Matthew 5–7; Mark 1–5; Luke 4–8; John 6", summary: "Centered at Capernaum, Jesus calls the Twelve, delivers the Beatitudes, calms the storm, and feeds the five thousand." },
      { step: 20, era: "Gospels: Northern Frontier", date: "c. 29 CE", title: "Caesarea Philippi Confession & the Transfiguration", from: "capernaum", to: "damascus", tradition: "NT_GOSPEL", books: ["MAT","MRK","LUK","2PE"], ref: "Matthew 16:13–17:9; 2 Peter 1:16–18", summary: "At the foot of Mount Hermon (Caesarea Philippi), Peter confesses Jesus as the Christ, followed by the Transfiguration on the high mountain." },
      { step: 21, era: "Gospels: Passion & Resurrection", date: "c. 30 CE", title: "Ascent through Samaria & Jericho to Jerusalem: Passion & Empty Tomb", from: "capernaum", to: "jerusalem", tradition: "NT_GOSPEL", books: ["MAT","MRK","LUK","JHN"], ref: "Luke 9:51–24:53; John 12–20", summary: "Jesus sets his face toward Jerusalem, institutes the New Covenant in the Upper Room, is crucified at Golgotha, and rises on the third day." },
      { step: 22, era: "Acts: Birth of the Church", date: "c. 30–34 CE", title: "Pentecost in Jerusalem, Samaria & the Gaza Road", from: "jerusalem", to: "gaza", tradition: "NT_EPISTLE", books: ["ACT","JOL","JAS","JUD"], ref: "Acts 1–8; James 1–5", summary: "The Holy Spirit descends at Pentecost; Philip proclaims Christ in Samaria and baptizes the Ethiopian treasurer on the desert road to Gaza." },
      { step: 23, era: "African & Ethiopian Horizon", date: "c. 34–330 CE", title: "From the Gaza Road to Meroë & Aksum: The Ethiopian Canon", from: "gaza", to: "aksum", tradition: "APOCRYPHA", books: ["ACT","1EN","JUB","1MEK"], ref: "Acts 8:26–39; Psalm 68:31", summary: "The Ethiopian official returns south toward Meroë (Kush) and Aksum, where the Ethiopian Tewahedo tradition preserves 1 Enoch, Jubilees, and Meqabyan alongside the 66 books." },
      { step: 24, era: "Acts: Conversion of Paul", date: "c. 34–37 CE", title: "Road to Damascus & Sojourn in Nabataean Arabia", from: "jerusalem", to: "damascus", tradition: "NT_EPISTLE", books: ["ACT","GAL"], ref: "Acts 9:1–25; Galatians 1:15–18", summary: "Blinded by the risen Christ outside Damascus, Saul of Tarsus is baptized via Ananias and spends three years in Nabataean Arabia and Damascus." },
      { step: 25, era: "Acts: Gentile Mission", date: "c. 40–46 CE", title: "Caesarea Maritima to Syrian Antioch: First Called 'Christians'", from: "caesarea", to: "antioch", tradition: "NT_EPISTLE", books: ["ACT","MAT","4MA"], ref: "Acts 10:1–11:26", summary: "Peter baptizes Cornelius's household in Caesarea; Barnabas and Saul gather the first Jew-Gentile church in Antioch." },
      { step: 26, era: "Paul's First Journey", date: "c. 47–49 CE", title: "First Missionary Journey: Antioch, Cyprus & Southern Galatia", from: "antioch", to: "galatia", tradition: "NT_EPISTLE", books: ["ACT","GAL"], ref: "Acts 13–14; Galatians 1–6", summary: "Paul and Barnabas sail to Cyprus and plant churches in Pisidian Antioch, Iconium, Lystra, and Derbe before the Jerusalem Council (Acts 15)." },
      { step: 27, era: "Paul's Second Journey", date: "c. 49–51 CE", title: "Macedonian Call: From Asia Minor to Philippi & Thessalonica", from: "galatia", to: "philippi", tradition: "NT_EPISTLE", books: ["ACT","1TH","2TH","PHP"], ref: "Acts 16:9–17:15; 1 Thessalonians 1–5", summary: "Guided by the vision of a man of Macedonia, Paul, Silas, Timothy, and Luke cross into Europe, founding churches at Philippi and Thessalonica." },
      { step: 28, era: "Paul's Second Journey", date: "c. 51–52 CE", title: "Athens Areopagus & Eighteen Months in Corinth (Writing 1–2 Thess)", from: "philippi", to: "corinth", tradition: "NT_EPISTLE", books: ["ACT","1TH","2TH"], ref: "Acts 17:16–18:18", summary: "After preaching the Unknown God on the Areopagus in Athens, Paul works with Priscilla and Aquila in Corinth and pens his earliest epistles." },
      { step: 29, era: "Paul's Third Journey", date: "c. 53–56 CE", title: "Three Years in Ephesus & Writing 1–2 Corinthians", from: "antioch", to: "ephesus", tradition: "NT_EPISTLE", books: ["ACT","1CO","2CO"], ref: "Acts 19:1–20:1; 1 Corinthians 13, 15", summary: "Teaching daily in the lecture hall of Tyrannus at Ephesus, Paul writes 1 Corinthians and later 2 Corinthians from Macedonia." },
      { step: 30, era: "Paul's Third Journey", date: "c. 57 CE", title: "Winter in Corinth: Dictating the Epistle to the Romans", from: "ephesus", to: "corinth", tradition: "NT_EPISTLE", books: ["ROM"], ref: "Romans 1:16–17; 16:22–23", summary: "Hosted by Gaius in Corinth, Paul dictates Romans to Tertius, laying out the sweeping theology of justification and preparing to bring the collection to Jerusalem." },
      { step: 31, era: "Arrest & Caesarea", date: "c. 57–59 CE", title: "Return to Jerusalem, Arrest in the Temple & Caesarea Imprisonment", from: "corinth", to: "caesarea", tradition: "NT_EPISTLE", books: ["ACT","LUK"], ref: "Acts 21–26", summary: "Arrested in Jerusalem and held two years in Caesarea under Felix and Festus, Paul testifies before King Agrippa II while Luke researches his Gospel." },
      { step: 32, era: "Voyage to Rome", date: "c. 59–60 CE", title: "Storm at Sea, Shipwreck on Malta & Arrival at Rome", from: "caesarea", to: "malta", tradition: "NT_EPISTLE", books: ["ACT"], ref: "Acts 27:1–28:14", summary: "Driven by the Euroclydon gale for fourteen days, Paul's ship runs aground on Malta before continuing to Puteoli and the Appian Way." },
      { step: 33, era: "Roman Epistles", date: "c. 60–67 CE", title: "Rome: Prison Epistles, Mark's Gospel, 1–2 Peter, Hebrews & 2 Timothy", from: "malta", to: "rome", tradition: "NT_EPISTLE", books: ["ACT","EPH","PHP","COL","PHM","MRK","1PE","2PE","HEB","2TI"], ref: "Acts 28:30–31; Philippians 2; 1 Peter 5:13; 2 Timothy 4:7", summary: "In Rome, Paul writes Ephesians, Philippians, Colossians, Philemon, and finally 2 Timothy; Peter and Mark minister to the Roman church." },
      { step: 34, era: "Eastern Apostolic Horizon", date: "c. 50–72 CE", title: "East of the Euphrates: Edessa & Thomas in Indo-Parthia / India", from: "jerusalem", to: "taxila", tradition: "APOCRYPHA", books: ["GTH"], ref: "Acts of Thomas; Patristic & Mar Thoma Tradition", summary: "While Paul travels west to Rome, apostolic mission moves east through Edessa (Syriac Christianity) and along maritime/caravan routes to Taxila and Muziris in India." },
      { step: 35, era: "Alexandrian & Coptic Legacy", date: "c. 62–200 CE", title: "Mark in Alexandria & Upper Egyptian Codices (Nag Hammadi)", from: "rome", to: "alexandria", tradition: "APOCRYPHA", books: ["MRK","GTH"], ref: "Eusebius, Hist. Eccl. 2.16; Nag Hammadi Codex II", summary: "John Mark establishes the Catechetical tradition in Alexandria; copies of early sayings and apocrypha are preserved in the dry sands of Oxyrhynchus and Nag Hammadi." },
      { step: 36, era: "Johannine Culmination", date: "c. 85–95 CE", title: "Ephesus & Island of Patmos: John's Gospel, Epistles & Revelation", from: "ephesus", to: "patmos", tradition: "PROPHECY", books: ["JHN","1JN","2JN","3JN","REV","2ES"], ref: "John 1:1–14; 1 John 4:8; Revelation 1, 21–22", summary: "From Ephesus and exile on Patmos, John bears witness to the incarnate Logos and beholds the New Jerusalem descending from heaven, bringing the biblical arc from Eden's garden to the Tree of Life." }
    ];

    // 5. INTERTEXTUAL LINKS (OT Prophecy / Apocrypha <-> NT Fulfillment / Quotation)
    const CROSS_LINKS = [
      { id: "L1", category: "Egypt & Nativity", fromBook: "HOS", fromRef: "Hosea 11:1 & Isaiah 19:1", toBook: "MAT", toRef: "Matthew 2:13–15 & Infancy Gospel", theme: "Out of Egypt I Called My Son", desc: "Hosea's memory of the Exodus and Isaiah's oracle of Egyptian idols trembling before the Lord converge in Matthew's account and the Coptic/Ethiopian Holy Family itinerary to Heliopolis and Deir el-Muharraq." },
      { id: "L2", category: "Enochic & Apostolic", fromBook: "1EN", fromRef: "1 Enoch 1:9 & 6–16", toBook: "JUD", toRef: "Jude 1:6, 14–15 & 2 Peter 2:4", theme: "Prophecy of Enoch, Seventh from Adam", desc: "The Epistle of Jude directly quotes 1 Enoch 1:9 ('Behold, the Lord comes with ten thousands of his holy ones') and references the Watchers tradition preserved in Qumran Aramaic fragments and the Ethiopian Ge'ez canon." },
      { id: "L3", category: "Son of Man & Apocalypse", fromBook: "DAN", fromRef: "Daniel 7:13–14 & 1 Enoch 46–48", toBook: "REV", toRef: "Revelation 1:13–14; Matthew 24:30", theme: "The Ancient of Days & Son of Man on the Clouds", desc: "Daniel's vision of One like a Son of Man receiving an everlasting kingdom shapes both the Similitudes of Enoch and the Apocalypse of John on Patmos." },
      { id: "L4", category: "Suffering & Atonement", fromBook: "ISA", fromRef: "Isaiah 52:13–53:12", toBook: "ACT", toRef: "Acts 8:32–35 & 1 Peter 2:22–25", theme: "The Suffering Servant & the Ethiopian Eunuch", desc: "On the road from Jerusalem to Gaza, Philip explains Isaiah 53 to the Ethiopian official of Queen Candace, launching the Gospel toward Meroë and Aksum." },
      { id: "L5", category: "Wisdom & Logos", fromBook: "PRO", fromRef: "Proverbs 8:22–31; Sirach 24; Wisdom 7:25–26", toBook: "JHN", toRef: "John 1:1–14; Colossians 1:15–17; Hebrews 1:3", theme: "Pre-Existent Wisdom & The Word Made Flesh", desc: "Hebrew and Alexandrian Jewish portraits of divine Wisdom as the radiance of eternal light and master worker at creation provide the vocabulary for John's Logos prologue and Hebrews 1:3." },
      { id: "L6", category: "New Covenant & Spirit", fromBook: "JER", fromRef: "Jeremiah 31:31–34 & Joel 2:28–32", toBook: "LUK", toRef: "Luke 22:20; Acts 2:17–21; Hebrews 8:8–12", theme: "Law Written on the Heart & Pentecost Outpouring", desc: "Jeremiah's promise of a New Covenant and Joel's prophecy of the Spirit poured out on all flesh are inaugurated at the Last Supper and Pentecost in Jerusalem." },
      { id: "L7", category: "Faith & Resurrection", fromBook: "HAB", fromRef: "Habakkuk 2:4 & 2 Maccabees 7", toBook: "ROM", toRef: "Romans 1:17; Galatians 3:11; Hebrews 11:35", theme: "The Righteous Shall Live by Faith & Martyr Resurrection", desc: "Habakkuk's watchtower oracle anchors Paul's theology in Romans and Galatians, while Hebrews 11:35 ('tortured, refusing release, to obtain a better resurrection') echoes the Maccabean martyrs of 2 Maccabees 7." },
      { id: "L8", category: "Eden to New Jerusalem", fromBook: "GEN", fromRef: "Genesis 2:8–9 & Ezekiel 47:1–12", toBook: "REV", toRef: "Revelation 22:1–5", theme: "River of Water of Life & Tree of Life for the Healing of the Nations", desc: "The Tree of Life guarded in Genesis 3 and Ezekiel's temple river flowing east to heal the Dead Sea find their ultimate fulfillment at the center of the New Jerusalem in Revelation 22." }
    ];

    // 6. APPLICATION STATE
    const state = {
      workspace: "journey",       // 'journey' | 'library' | 'loom' | 'links'
      tradition: "ALL",           // 'ALL' | 'OT' | 'NT_GOSPEL' | 'NT_EPISTLE' | 'APOCRYPHA' | 'PROPHECY'
      currentStep: 1,             // 1..36
      cumulativeMode: true,       // show all arcs up to currentStep
      holyFamilyOverlay: true,    // highlight Egypt Holy Family route
      projectionMode: "2d",       // '2d' | '3d'
      playing: false,
      playTimer: null,
      selectedBookId: "GEN",
      libraryTradFilter: "ALL",
      librarySearch: "",
      loomWriterFilter: "ALL",
      worldTopo: null,
      zoomTransform: d3.zoomIdentity,
      globeRotation: [-33, -29, 0]
    };

    // 7. NULL-SAFE DOM HELPER (Prevents Cannot read properties of null 'addEventListener')
    function $(id) {
      return document.getElementById(id);
    }
    function bindOn(id, event, handler) {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener(event, handler);
      }
      return el;
    }

    // 8. SVG SHAPE GENERATOR FOR DUAL-ENCODED MARKERS
    function getMarkerPath(tradition, size = 7) {
      switch (tradition) {
        case "OT": // Square
          return `M ${-size} ${-size} L ${size} ${-size} L ${size} ${size} L ${-size} ${size} Z`;
        case "NT_GOSPEL": // Circle
          return d3.symbol().type(d3.symbolCircle).size(size * size * 3.2)();
        case "NT_EPISTLE": // Triangle
          return d3.symbol().type(d3.symbolTriangle).size(size * size * 3.2)();
        case "APOCRYPHA": // Diamond
          return `M 0 ${-size * 1.25} L ${size * 1.15} 0 L 0 ${size * 1.25} L ${-size * 1.15} 0 Z`;
        case "PROPHECY": // Star
          return d3.symbol().type(d3.symbolStar).size(size * size * 3.2)();
        default:
          return d3.symbol().type(d3.symbolCircle).size(size * size * 3)();
      }
    }

    // 9. INITIALIZE & RENDER MAP (D3 2D NaturalEarth / Mercator + 3D Orthographic Globe)
    let svg, mapGroup, landGroup, graticuleGroup, routeGroup, nodeGroup, labelGroup, zoomBehavior;
    const mapWidth = 960;
    const mapHeight = 560;

    function initMap() {
      const container = $("map-svg-container");
      if (!container) return;
      container.innerHTML = "";

      svg = d3.select(container)
        .append("svg")
        .attr("viewBox", `0 0 ${mapWidth} ${mapHeight}`)
        .attr("class", "w-full h-full select-none");

      // SVG Defs for directional arrowheads per tradition
      const defs = svg.append("defs");
      Object.values(TRADITIONS).forEach(t => {
        defs.append("marker")
          .attr("id", `arrow-${t.id}`)
          .attr("viewBox", "0 -5 10 10")
          .attr("refX", 8)
          .attr("refY", 0)
          .attr("markerWidth", 5.5)
          .attr("markerHeight", 5.5)
          .attr("orient", "auto")
          .append("path")
          .attr("d", "M0,-4L10,0L0,4")
          .attr("fill", t.color);
      });

      mapGroup = svg.append("g").attr("class", "map-root");
      graticuleGroup = mapGroup.append("g").attr("class", "graticule-layer");
      landGroup = mapGroup.append("g").attr("class", "land-layer");
      routeGroup = mapGroup.append("g").attr("class", "route-layer");
      nodeGroup = mapGroup.append("g").attr("class", "node-layer");
      labelGroup = mapGroup.append("g").attr("class", "label-layer");

      zoomBehavior = d3.zoom()
        .scaleExtent([0.8, 12])
        .on("zoom", (event) => {
          if (state.projectionMode === "2d") {
            state.zoomTransform = event.transform;
            mapGroup.attr("transform", event.transform);
          }
        });

      svg.call(zoomBehavior);

      // Drag support for 3D Orthographic Globe mode
      const dragBehavior = d3.drag()
        .subject(() => {
          const r = state.globeRotation;
          return { x: r[0] / 0.4, y: -r[1] / 0.4 };
        })
        .on("drag", (event) => {
          if (state.projectionMode === "3d") {
            state.globeRotation = [
              event.x * 0.4,
              Math.max(-75, Math.min(75, -event.y * 0.4)),
              0
            ];
            renderMap();
          }
        });

      svg.call(dragBehavior);

      // Load World Atlas TopoJSON with immediate fallback
      fetch("https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json")
        .then(r => r.ok ? r.json() : Promise.reject())
        .then(topo => {
          state.worldTopo = topo;
          renderMap();
        })
        .catch(() => {
          renderMap();
        });
    }

    function getProjection() {
      if (state.projectionMode === "3d") {
        return d3.geoOrthographic()
          .scale(480)
          .translate([mapWidth / 2, mapHeight / 2])
          .rotate(state.globeRotation)
          .clipAngle(90);
      }
      return d3.geoMercator()
        .center([35.2, 30.2])
        .scale(1050)
        .translate([mapWidth / 2, mapHeight / 2]);
    }

    function renderMap() {
      if (!svg) return;
      const projection = getProjection();
      const geoPath = d3.geoPath().projection(projection);

      if (state.projectionMode === "3d") {
        mapGroup.attr("transform", null);
      } else {
        mapGroup.attr("transform", state.zoomTransform);
      }

      // Graticule
      const graticule = d3.geoGraticule().step([5, 5]);
      graticuleGroup.selectAll("path")
        .data([graticule()])
        .join("path")
        .attr("d", geoPath)
        .attr("fill", "none")
        .attr("stroke", "#1e293b")
        .attr("stroke-width", 0.5)
        .attr("stroke-dasharray", "2,2");

      // Landmasses
      if (state.worldTopo && window.topojson) {
        const land = topojson.feature(state.worldTopo, state.worldTopo.objects.countries);
        landGroup.selectAll("path")
          .data(land.features)
          .join("path")
          .attr("d", geoPath)
          .attr("fill", "#0f172a")
          .attr("stroke", "#334155")
          .attr("stroke-width", 0.6);
      }

      // Filter active journey steps
      const visibleSteps = JOURNEY_STEPS.filter(s => {
        const withinStep = state.cumulativeMode ? s.step <= state.currentStep : s.step === state.currentStep;
        if (!withinStep) return false;
        if (state.tradition !== "ALL" && s.tradition !== state.tradition) return false;
        return true;
      });

      // Optionally include Holy Family Egypt steps (15, 16, 17) when overlay is toggled
      const egyptSteps = state.holyFamilyOverlay
        ? JOURNEY_STEPS.filter(s => [15, 16, 17].includes(s.step) && !visibleSteps.some(v => v.step === s.step))
        : [];

      const allArcs = [...visibleSteps, ...egyptSteps];

      // Draw Route Arcs
      routeGroup.selectAll("path.journey-arc")
        .data(allArcs, d => d.step)
        .join("path")
        .attr("class", "journey-arc cursor-pointer transition-opacity")
        .attr("d", d => {
          const p1 = PLACES[d.from];
          const p2 = PLACES[d.to];
          if (!p1 || !p2) return null;
          const c1 = projection([p1.lon, p1.lat]);
          const c2 = projection([p2.lon, p2.lat]);
          if (!c1 || !c2) return null;
          const dx = c2[0] - c1[0];
          const dy = c2[1] - c1[1];
          const dr = Math.sqrt(dx * dx + dy * dy) * 1.25;
          return `M${c1[0]},${c1[1]}A${dr},${dr} 0 0,1 ${c2[0]},${c2[1]}`;
        })
        .attr("fill", "none")
        .attr("stroke", d => (TRADITIONS[d.tradition] || TRADITIONS.OT).color)
        .attr("stroke-width", d => d.step === state.currentStep ? 3.2 : 1.75)
        .attr("stroke-dasharray", d => {
          if ([15, 16, 17].includes(d.step)) return "5,3";
          return (TRADITIONS[d.tradition] || TRADITIONS.OT).dash;
        })
        .attr("opacity", d => d.step === state.currentStep ? 1 : 0.65)
        .attr("marker-end", d => `url(#arrow-${d.tradition})`)
        .on("click", (e, d) => {
          setStep(d.step);
        });

      // Active Places
      const activePlaceIds = new Set();
      allArcs.forEach(s => {
        activePlaceIds.add(s.from);
        activePlaceIds.add(s.to);
      });
      // Always include places of books matching current tradition filter
      BOOKS.forEach(b => {
        if (state.tradition === "ALL" || b.tradition === state.tradition) {
          activePlaceIds.add(b.placeId);
        }
      });

      const currentStepObj = JOURNEY_STEPS.find(s => s.step === state.currentStep) || JOURNEY_STEPS[0];
      const placeList = Object.values(PLACES).filter(p => activePlaceIds.has(p.id));

      // Draw Place Nodes
      const nodes = nodeGroup.selectAll("g.place-node")
        .data(placeList, d => d.id)
        .join("g")
        .attr("class", "place-node cursor-pointer")
        .attr("transform", d => {
          const coords = projection([d.lon, d.lat]);
          return coords ? `translate(${coords[0]},${coords[1]})` : "translate(-999,-999)";
        })
        .on("click", (e, d) => {
          inspectPlace(d.id);
        });

      nodes.selectAll("circle.pulse-ring").remove();
      nodes.filter(d => d.id === currentStepObj.from || d.id === currentStepObj.to)
        .append("circle")
        .attr("class", "pulse-ring")
        .attr("r", 11)
        .attr("fill", "none")
        .attr("stroke", "#2dd4bf")
        .attr("stroke-width", 2)
        .attr("opacity", 0.85);

      nodes.selectAll("path.node-shape")
        .data(d => [d])
        .join("path")
        .attr("class", "node-shape")
        .attr("d", d => {
          const primaryBook = BOOKS.find(b => b.placeId === d.id);
          const trad = primaryBook ? primaryBook.tradition : "OT";
          const isCurrent = d.id === currentStepObj.from || d.id === currentStepObj.to;
          return getMarkerPath(trad, isCurrent ? 6.5 : 4.8);
        })
        .attr("fill", d => {
          const primaryBook = BOOKS.find(b => b.placeId === d.id);
          const trad = primaryBook ? primaryBook.tradition : "OT";
          return (TRADITIONS[trad] || TRADITIONS.OT).color;
        })
        .attr("stroke", "#090d16")
        .attr("stroke-width", 1.5);

      // Labels for places
      labelGroup.selectAll("text.place-label")
        .data(placeList, d => d.id)
        .join("text")
        .attr("class", "place-label pointer-events-none")
        .attr("transform", d => {
          const coords = projection([d.lon, d.lat]);
          return coords ? `translate(${coords[0] + 8},${coords[1] + 3})` : "translate(-999,-999)";
        })
        .text(d => d.name.split(" (")[0])
        .attr("fill", d => (d.id === currentStepObj.from || d.id === currentStepObj.to) ? "#ffffff" : "#cbd5e1")
        .attr("font-size", d => (d.id === currentStepObj.from || d.id === currentStepObj.to) ? "11px" : "9.5px")
        .attr("font-weight", d => (d.id === currentStepObj.from || d.id === currentStepObj.to) ? "700" : "500")
        .style("text-shadow", "0 1px 3px #000, 0 0 5px #000");
    }

    // 10. UPDATE JOURNEY STEP & SYNCHRONIZED SIDEBAR
    function setStep(stepNum) {
      state.currentStep = Math.max(1, Math.min(JOURNEY_STEPS.length, Number(stepNum) || 1));
      const stepObj = JOURNEY_STEPS.find(s => s.step === state.currentStep) || JOURNEY_STEPS[0];

      const slider = $("journey-slider");
      if (slider) slider.value = String(state.currentStep);

      const badge = $("step-counter-badge");
      if (badge) badge.textContent = `Step ${stepObj.step} / ${JOURNEY_STEPS.length} • ${stepObj.era}`;

      const dateBadge = $("step-date-badge");
      if (dateBadge) dateBadge.textContent = stepObj.date;

      const titleEl = $("step-title");
      if (titleEl) titleEl.textContent = stepObj.title;

      const refEl = $("step-ref");
      if (refEl) refEl.textContent = stepObj.ref;

      const sumEl = $("step-summary");
      if (sumEl) sumEl.textContent = stepObj.summary;

      const fromPlace = PLACES[stepObj.from];
      const toPlace = PLACES[stepObj.to];
      const routeEl = $("step-route-pill");
      if (routeEl && fromPlace && toPlace) {
        routeEl.textContent = `${fromPlace.name} → ${toPlace.name}`;
      }

      // Render Step Linked Books Pills
      const stepBooksContainer = $("step-books-list");
      if (stepBooksContainer) {
        stepBooksContainer.innerHTML = stepObj.books.map(bookId => {
          const b = BOOKS.find(x => x.id === bookId);
          if (!b) return "";
          const t = TRADITIONS[b.tradition] || TRADITIONS.OT;
          return `
            <button data-open-book="${b.id}" class="px-2.5 py-1 rounded text-xs font-semibold border transition flex items-center gap-1.5 bg-slate-900 hover:bg-slate-800" style="border-color:${t.color}66; color:${t.color}">
              <span>${t.shape}</span>
              <span>${b.title}</span>
              <span class="text-[10px] text-slate-400">(${b.chapters} ch)</span>
            </button>
          `;
        }).join("");

        stepBooksContainer.querySelectorAll("[data-open-book]").forEach(btn => {
          btn.addEventListener("click", () => {
            selectBook(btn.getAttribute("data-open-book"));
          });
        });
      }

      // Auto-select first book of this step in the inspector
      if (stepObj.books.length > 0) {
        selectBook(stepObj.books[0], false);
      }

      // Highlight active step in the 36-step vertical list
      document.querySelectorAll("[data-step-item]").forEach(el => {
        const s = Number(el.getAttribute("data-step-item"));
        if (s === state.currentStep) {
          el.classList.add("border-teal-500", "bg-teal-950/30");
          el.classList.remove("border-slate-800", "bg-slate-900/60");
        } else {
          el.classList.remove("border-teal-500", "bg-teal-950/30");
          el.classList.add("border-slate-800", "bg-slate-900/60");
        }
      });

      // If in 3D mode, smoothly center globe on target place
      if (state.projectionMode === "3d" && toPlace) {
        state.globeRotation = [-toPlace.lon, -toPlace.lat, 0];
      }

      renderMap();
    }

    // 11. BOOK & PASSAGE INSPECTOR (Right Sidebar + Library Modal)
    function selectBook(bookId, panMap = true) {
      const book = BOOKS.find(b => b.id === bookId) || BOOKS[0];
      state.selectedBookId = book.id;
      const trad = TRADITIONS[book.tradition] || TRADITIONS.OT;
      const place = PLACES[book.placeId];

      const inspector = $("book-inspector-card");
      if (inspector) {
        inspector.innerHTML = `
          <div class="flex items-start justify-between gap-2 border-b border-slate-800 pb-2.5">
            <div>
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-bold px-2 py-0.5 rounded" style="background:${trad.color}22; color:${trad.color}; border:1px solid ${trad.color}55">
                  ${trad.shape} ${trad.name}
                </span>
                <span class="text-[11px] text-slate-400 font-mono">${book.chapters} Chapters/Units</span>
              </div>
              <h3 class="text-base font-bold text-white mt-1.5">${book.title}</h3>
            </div>
            <span class="text-[11px] px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">${book.date}</span>
          </div>

          <div class="grid grid-cols-1 gap-2 text-xs mt-2.5">
            <div class="bg-slate-950/70 p-2 rounded border border-slate-800/80">
              <span class="text-slate-400 block text-[10px] uppercase tracking-wider">Traditional Attribution</span>
              <span class="text-slate-100 font-semibold">${book.writerTrad}</span>
            </div>
            <div class="bg-slate-950/70 p-2 rounded border border-slate-800/80">
              <span class="text-slate-400 block text-[10px] uppercase tracking-wider">Historical / Redactional Context</span>
              <span class="text-slate-200">${book.writerSch}</span>
            </div>
            <div class="flex items-center justify-between bg-slate-950/70 p-2 rounded border border-slate-800/80">
              <div>
                <span class="text-slate-400 block text-[10px] uppercase tracking-wider">Primary Geographical Hub</span>
                <span class="text-teal-300 font-medium">${place ? place.name : book.placeId}</span>
              </div>
              <div class="text-right">
                <span class="text-slate-400 block text-[10px] uppercase tracking-wider">Canonical Reception</span>
                <span class="text-slate-200 font-medium">${book.canon}</span>
              </div>
            </div>
          </div>

          <div class="mt-3">
            <h4 class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-1.5">
              Passage-by-Passage Structural Breakdown
            </h4>
            <div class="space-y-1.5">
              ${book.passages.map(p => `
                <div class="p-2 rounded bg-slate-950/90 border border-slate-800/90 flex items-start gap-2">
                  <span class="px-1.5 py-0.5 rounded bg-slate-800 text-teal-300 font-mono text-[11px] shrink-0">
                    Ch. ${p.range}
                  </span>
                  <p class="text-xs text-slate-200 leading-snug">${p.summary}</p>
                </div>
              `).join("")}
            </div>
          </div>
        `;
      }

      if (panMap && place && state.projectionMode === "3d") {
        state.globeRotation = [-place.lon, -place.lat, 0];
        renderMap();
      }
    }

    function inspectPlace(placeId) {
      const place = PLACES[placeId];
      if (!place) return;
      const booksHere = BOOKS.filter(b => b.placeId === placeId);
      const stepsHere = JOURNEY_STEPS.filter(s => s.from === placeId || s.to === placeId);

      if (booksHere.length > 0) {
        selectBook(booksHere[0].id, false);
      }
      if (stepsHere.length > 0) {
        setStep(stepsHere[0].step);
      }
    }

    // 12. RENDER 36-STEP LIST IN JOURNEY DRAWER
    function renderStepList() {
      const container = $("journey-step-list");
      if (!container) return;
      container.innerHTML = JOURNEY_STEPS.map(s => {
        const t = TRADITIONS[s.tradition] || TRADITIONS.OT;
        return `
          <button data-step-item="${s.step}" class="w-full text-left p-2.5 rounded-lg border border-slate-800 bg-slate-900/60 hover:bg-slate-800/80 transition flex items-start gap-2.5">
            <span class="w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold shrink-0 mt-0.5" style="background:${t.color}22; color:${t.color}; border:1px solid ${t.color}55">
              ${s.step}
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between gap-1">
                <span class="text-[10px] font-semibold uppercase tracking-wider" style="color:${t.color}">${s.era}</span>
                <span class="text-[10px] text-slate-400 font-mono">${s.date}</span>
              </div>
              <p class="text-xs font-semibold text-slate-100 truncate mt-0.5">${s.title}</p>
              <p class="text-[11px] text-slate-400 truncate">${s.ref}</p>
            </div>
          </button>
        `;
      }).join("");

      container.querySelectorAll("[data-step-item]").forEach(btn => {
        btn.addEventListener("click", () => {
          setStep( Number(btn.getAttribute("data-step-item")) );
        });
      });
    }

    // 13. RENDER LIBRARY WORKSPACE (All 84 Books with Search & Tradition Filter)
    function renderLibrary() {
      const grid = $("library-books-grid");
      if (!grid) return;

      const query = state.librarySearch.trim().toLowerCase();
      const filtered = BOOKS.filter(b => {
        if (state.tradition !== "ALL" && b.tradition !== state.tradition) return false;
        if (state.libraryTradFilter !== "ALL" && b.tradition !== state.libraryTradFilter) return false;
        if (!query) return true;
        const hay = `${b.title} ${b.writerTrad} ${b.writerSch} ${b.canon} ${b.passages.map(p => p.summary).join(" ")}`.toLowerCase();
        return hay.includes(query);
      });

      const countEl = $("library-count-badge");
      if (countEl) countEl.textContent = `Showing ${filtered.length} of ${BOOKS.length} Books`;

      grid.innerHTML = filtered.map(b => {
        const t = TRADITIONS[b.tradition] || TRADITIONS.OT;
        const place = PLACES[b.placeId];
        return `
          <article class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 flex flex-col justify-between hover:border-slate-700 transition">
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-[11px] font-bold px-2 py-0.5 rounded" style="background:${t.color}20; color:${t.color}; border:1px solid ${t.color}55">
                  ${t.shape} ${t.name}
                </span>
                <span class="text-[11px] font-mono text-slate-400">${b.chapters} ch • ${b.date}</span>
              </div>
              <h3 class="text-base font-bold text-white mt-2">${b.title}</h3>
              <p class="text-xs text-slate-300 mt-1">
                <strong class="text-slate-400">Writer:</strong> ${b.writerTrad}
              </p>
              <p class="text-[11px] text-slate-400 mt-0.5">${b.writerSch}</p>
              <div class="mt-2 flex flex-wrap items-center gap-1.5 text-[11px]">
                <span class="px-2 py-0.5 rounded bg-slate-950 text-teal-300 border border-slate-800">
                  📍 ${place ? place.name : b.placeId}
                </span>
                <span class="px-2 py-0.5 rounded bg-slate-950 text-slate-300 border border-slate-800">
                  📜 ${b.canon}
                </span>
              </div>
              <div class="mt-3 space-y-1 border-t border-slate-800/80 pt-2.5">
                ${b.passages.map(p => `
                  <div class="text-xs flex items-start gap-1.5">
                    <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-teal-300 shrink-0">${p.range}</span>
                    <span class="text-slate-300">${p.summary}</span>
                  </div>
                `).join("")}
              </div>
            </div>
            <div class="mt-3 pt-2 border-t border-slate-800/60 flex justify-end">
              <button data-locate-book="${b.id}" class="text-xs font-semibold text-teal-300 hover:text-teal-200 flex items-center gap-1">
                🗺️ Locate on Atlas &amp; Inspect →
              </button>
            </div>
          </article>
        `;
      }).join("");

      grid.querySelectorAll("[data-locate-book]").forEach(btn => {
        btn.addEventListener("click", () => {
          const bid = btn.getAttribute("data-locate-book");
          switchWorkspace("journey");
          selectBook(bid, true);
          const stepWithBook = JOURNEY_STEPS.find(s => s.books.includes(bid));
          if (stepWithBook) setStep(stepWithBook.step);
        });
      });
    }

    // 14. RENDER LOOM WORKSPACE (Writers, Redactional Traditions & Canonical Matrix)
    function renderLoom() {
      const container = $("loom-matrix-container");
      if (!container) return;

      // Group books by primary writer/tradition cluster
      const writerGroups = [
        { group: "Moses & Torah Tradition", era: "c. 1440–1400 BCE", region: "Sinai & Plains of Moab", books: ["GEN","EXO","LEV","NUM","DEU","JOB","JUB"] },
        { group: "Prophetic Historians (Joshua, Samuel, Jeremiah, Ezra)", era: "c. 1350–430 BCE", region: "Shiloh, Jerusalem, Babylon, Susa", books: ["JOS","JDG","RUT","1SA","2SA","1KI","2KI","1CH","2CH","EZR","NEH","EST","1ES"] },
        { group: "Davidic, Solomonic & Jerusalem Wisdom Scribes", era: "c. 1000–50 BCE", region: "Jerusalem, Qumran & Alexandria", books: ["PSA","PS151","PRO","ECC","SNG","SIR","WIS","PR_MAN"] },
        { group: "Major & Minor Prophets of Israel & Judah", era: "c. 760–430 BCE", region: "Jerusalem, Samaria, Nineveh, Babylon", books: ["ISA","JER","LAM","BAR","EZK","DAN","HOS","JOL","AMO","OBA","JON","MIC","NAH","HAB","ZEP","HAG","ZEC","MAL"] },
        { group: "Enochic, Maccabean & Second Temple Apocalyptists", era: "c. 300 BCE–100 CE", region: "Galilee, Judea, Qumran, Axum, Alexandria", books: ["1EN","2EN","TOB","JDT","1MA","2MA","3MA","4MA","2ES","1MEQ","2MEQ","3MEQ"] },
        { group: "Evangelists & Holy Family Infancy Traditions", era: "c. 50–110 CE", region: "Antioch, Rome, Ephesus, Alexandria, Bahnasa", books: ["MAT","MRK","LUK","JHN","PJAM","INF_THO","AR_INF","PS_MAT","JOS_CAR"] },
        { group: "Pauline & Apostolic Epistolary Network", era: "c. 48–96 CE", region: "Corinth, Ephesus, Rome, Jerusalem, Patmos", books: ["ACT","ROM","1CO","2CO","GAL","EPH","PHP","COL","1TH","2TH","1TI","2TI","TIT","PHM","HEB","JAS","1PE","2PE","1JN","2JN","3JN","JUD","REV"] }
      ];

      container.innerHTML = writerGroups.map(wg => {
        const groupBooks = wg.books
          .map(id => BOOKS.find(b => b.id === id))
          .filter(b => b && (state.tradition === "ALL" || b.tradition === state.tradition));

        if (groupBooks.length === 0) return "";

        return `
          <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3 mb-3">
              <div>
                <h3 class="text-sm sm:text-base font-bold text-white">${wg.group}</h3>
                <p class="text-xs text-slate-400">📍 ${wg.region} • ⏳ ${wg.era}</p>
              </div>
              <span class="text-xs font-semibold px-2.5 py-1 rounded bg-slate-950 text-teal-300 border border-slate-800">
                ${groupBooks.length} Texts
              </span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-2.5">
              ${groupBooks.map(b => {
                const t = TRADITIONS[b.tradition] || TRADITIONS.OT;
                const p = PLACES[b.placeId];
                return `
                  <div class="p-3 rounded-lg bg-slate-950/90 border border-slate-800/90 hover:border-slate-700 transition flex flex-col justify-between">
                    <div>
                      <div class="flex items-center justify-between gap-1">
                        <span class="text-xs font-bold" style="color:${t.color}">${t.shape} ${b.title}</span>
                        <span class="text-[10px] font-mono text-slate-400">${b.date}</span>
                      </div>
                      <p class="text-[11px] text-slate-200 mt-1"><strong>Traditional:</strong> ${b.writerTrad}</p>
                      <p class="text-[11px] text-slate-400 mt-0.5"><strong>Critical/Redactional:</strong> ${b.writerSch}</p>
                    </div>
                    <div class="mt-2 pt-2 border-t border-slate-900 flex items-center justify-between text-[10px]">
                      <span class="text-teal-300">📍 ${p ? p.name : b.placeId}</span>
                      <button data-loom-open="${b.id}" class="text-slate-300 hover:text-white underline font-semibold">Inspect →</button>
                    </div>
                  </div>
                `;
              }).join("")}
            </div>
          </div>
        `;
      }).join("");

      container.querySelectorAll("[data-loom-open]").forEach(btn => {
        btn.addEventListener("click", () => {
          const bid = btn.getAttribute("data-loom-open");
          switchWorkspace("journey");
          selectBook(bid, true);
        });
      });
    }

    // 15. RENDER LINKS WORKSPACE (Intertextual, Typological & Geographical Cross-Links)
    function renderLinks() {
      const container = $("links-grid-container");
      if (!container) return;

      container.innerHTML = CROSS_LINKS.map((lnk, idx) => {
        const bFrom = BOOKS.find(b => b.id === lnk.fromBook) || BOOKS[0];
        const bTo = BOOKS.find(b => b.id === lnk.toBook) || BOOKS[1];
        const tFrom = TRADITIONS[bFrom.tradition] || TRADITIONS.OT;
        const tTo = TRADITIONS[bTo.tradition] || TRADITIONS.OT;

        return `
          <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 flex flex-col justify-between hover:border-slate-700 transition">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-teal-950/90 text-teal-300 border border-teal-700/50">
                  Link #${idx + 1} • ${lnk.theme}
                </span>
                <span class="text-[11px] font-mono text-slate-400">${lnk.places.map(pid => PLACES[pid]?.name.split(" (")[0] || pid).join(" ⇄ ")}</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 my-2.5">
                <div class="p-2.5 rounded-lg bg-slate-950 border border-slate-800">
                  <span class="text-[10px] uppercase tracking-wider block" style="color:${tFrom.color}">Source Text (${tFrom.shape})</span>
                  <p class="text-xs font-bold text-white mt-0.5">${bFrom.title}</p>
                  <p class="text-[11px] font-mono text-teal-300 mt-0.5">${lnk.fromRef}</p>
                </div>
                <div class="p-2.5 rounded-lg bg-slate-950 border border-slate-800">
                  <span class="text-[10px] uppercase tracking-wider block" style="color:${tTo.color}">Target / Fulfillment (${tTo.shape})</span>
                  <p class="text-xs font-bold text-white mt-0.5">${bTo.title}</p>
                  <p class="text-[11px] font-mono text-teal-300 mt-0.5">${lnk.toRef}</p>
                </div>
              </div>

              <p class="text-xs text-slate-300 leading-relaxed mt-2">${lnk.desc}</p>
            </div>

            <div class="mt-3 pt-2.5 border-t border-slate-800 flex items-center justify-between gap-2">
              <button data-link-book="${bFrom.id}" class="text-xs text-amber-300 hover:underline font-medium">
                Inspect ${bFrom.title}
              </button>
              <button data-link-book="${bTo.id}" class="text-xs text-sky-300 hover:underline font-medium">
                Inspect ${bTo.title} →
              </button>
            </div>
          </div>
        `;
      }).join("");

      container.querySelectorAll("[data-link-book]").forEach(btn => {
        btn.addEventListener("click", () => {
          const bid = btn.getAttribute("data-link-book");
          switchWorkspace("journey");
          selectBook(bid, true);
          const stepWithBook = JOURNEY_STEPS.find(s => s.books.includes(bid));
          if (stepWithBook) setStep(stepWithBook.step);
        });
      });
    }

    // 16. WORKSPACE SWITCHING & EVENT LISTENERS
    function switchWorkspace(ws) {
      state.workspace = ws;
      ["journey", "library", "loom", "links"].forEach(id => {
        const panel = $(`ws-${id}`);
        if (panel) {
          panel.classList.toggle("hidden", id !== ws);
        }
      });

      document.querySelectorAll(".ws-tab").forEach(btn => {
        const active = btn.getAttribute("data-workspace") === ws;
        btn.className = active
          ? "ws-tab px-3 py-1.5 rounded-md text-xs font-semibold transition bg-teal-600 text-white shadow"
          : "ws-tab px-3 py-1.5 rounded-md text-xs font-semibold transition text-slate-300 hover:text-white hover:bg-slate-800/70";
      });

      if (ws === "journey") renderMap();
      if (ws === "library") renderLibrary();
      if (ws === "loom") renderLoom();
      if (ws === "links") renderLinks();
    }

    function togglePlay() {
      state.playing = !state.playing;
      const playBtn = $("btn-play-journey");
      if (playBtn) {
        playBtn.textContent = state.playing ? "⏸ Pause" : "▶ Play 36 Steps";
      }
      if (state.playing) {
        state.playTimer = setInterval(() => {
          const next = state.currentStep < JOURNEY_STEPS.length ? state.currentStep + 1 : 1;
          setStep(next);
        }, 2200);
      } else if (state.playTimer) {
        clearInterval(state.playTimer);
        state.playTimer = null;
      }
    }

    function wireEvents() {
      // Workspace tabs
      document.querySelectorAll(".ws-tab").forEach(btn => {
        btn.addEventListener("click", () => {
          switchWorkspace(btn.getAttribute("data-workspace"));
        });
      });

      // Global tradition filter pills
      document.querySelectorAll(".trad-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          state.tradition = btn.getAttribute("data-tradition") || "ALL";
          document.querySelectorAll(".trad-btn").forEach(b => {
            const isAct = b.getAttribute("data-tradition") === state.tradition;
            b.classList.toggle("ring-2", isAct);
            b.classList.toggle("ring-teal-400", isAct);
          });
          renderMap();
          renderLibrary();
          renderLoom();
        });
      });

      // Journey controls (Null-safe via bindOn)
      bindOn("btn-prev-step", "click", () => setStep(state.currentStep - 1));
      bindOn("btn-next-step", "click", () => setStep(state.currentStep + 1));
      bindOn("btn-play-journey", "click", togglePlay);
      bindOn("journey-slider", "input", (e) => setStep(Number(e.target.value)));

      // Cumulative vs Single Step toggle
      bindOn("chk-cumulative", "change", (e) => {
        state.cumulativeMode = Boolean(e.target.checked);
        renderMap();
      });

      // Holy Family Egypt Overlay toggle
      bindOn("chk-holy-family", "change", (e) => {
        state.holyFamilyOverlay = Boolean(e.target.checked);
        renderMap();
      });

      // 2D / 3D Globe Toggle
      bindOn("btn-proj-2d", "click", () => {
        state.projectionMode = "2d";
        const b2 = $("btn-proj-2d");
        const b3 = $("btn-proj-3d");
        if (b2) b2.className = "px-2.5 py-1 rounded text-xs font-semibold bg-teal-600 text-white";
        if (b3) b3.className = "px-2.5 py-1 rounded text-xs font-semibold text-slate-300 hover:text-white";
        renderMap();
      });

      bindOn("btn-proj-3d", "click", () => {
        state.projectionMode = "3d";
        const b2 = $("btn-proj-2d");
        const b3 = $("btn-proj-3d");
        if (b3) b3.className = "px-2.5 py-1 rounded text-xs font-semibold bg-teal-600 text-white";
        if (b2) b2.className = "px-2.5 py-1 rounded text-xs font-semibold text-slate-300 hover:text-white";
        renderMap();
      });

      // Reset Map Zoom / Rotation
      bindOn("btn-reset-map", "click", () => {
        state.zoomTransform = d3.zoomIdentity;
        state.globeRotation = [-35.2, -30.2, 0];
        if (svg && zoomBehavior) {
          svg.transition().duration(450).call(zoomBehavior.transform, d3.zoomIdentity);
        }
        renderMap();
      });

      // Color Vision Deficiency (CVD) Proofing Mode Selector
      bindOn("cvd-mode-select", "change", (e) => {
        document.body.classList.remove("cvd-deuteranopia", "cvd-grayscale");
        if (e.target.value === "deuteranopia") document.body.classList.add("cvd-deuteranopia");
        if (e.target.value === "grayscale") document.body.classList.add("cvd-grayscale");
      });

      // Library search & sub-filter
      bindOn("library-search-input", "input", (e) => {
        state.librarySearch = e.target.value || "";
        renderLibrary();
      });

      bindOn("library-trad-select", "change", (e) => {
        state.libraryTradFilter = e.target.value || "ALL";
        renderLibrary();
      });

      // Keyboard navigation for 36-step timeline
      window.addEventListener("keydown", (e) => {
        if (["INPUT", "SELECT", "TEXTAREA"].includes(document.activeElement?.tagName)) return;
        if (e.key === "ArrowRight") {
          e.preventDefault();
          setStep(state.currentStep + 1);
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          setStep(state.currentStep - 1);
        } else if (e.key === " ") {
          if (state.workspace === "journey") {
            e.preventDefault();
            togglePlay();
          }
        }
      });
    }

    // 17. BOOTSTRAP APPLICATION ON DOM READY
    function boot() {
      initMap();
      renderStepList();
      wireEvents();
      setStep(1);
      selectBook("GEN", false);
      renderLibrary();
      renderLoom();
      renderLinks();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot);
    } else {
      boot();
    }
  </script>
</body>
</html>