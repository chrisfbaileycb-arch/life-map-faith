          summary: "The Holy Family rests beneath the balsam-bearing Sycamore tree at Matariya (Heliopolis) and dwells in the cave of Abu Serga in Old Cairo (Babylon-in-Egypt / Memphis)." },
        { step: 13, group: "HOLY_FAMILY_AFRICA", bookId: "INF", from: "Memphis", to: "Hermopolis", waypoints: ["Memphis", "Oxyrhynchus", "Hermopolis"],
          title: "Sailing South on the Nile: Al-Bahnasa (Oxyrhynchus) to Ashmunayn",
          summary: "Boarding a Nile papyrus boat at Maadi, the Holy Family travels south into Middle Egypt through Al-Bahnasa (Oxyrhynchus) and Gabal al-Tayr to Hermopolis Magna (Al-Ashmunayn), fulfilling Isaiah 19:1." },
        { step: 14, group: "HOLY_FAMILY_AFRICA", bookId: "INF", from: "Hermopolis", to: "Muharraq", waypoints: ["Hermopolis", "Muharraq"],
          title: "Sanctuary at Mount Qusqam (Deir al-Muharraq — Center of Egypt)",
          summary: "At the foot of Mount Qusqam in Assiut (Deir al-Muharraq), the Holy Family dwells for over six months—their longest stay—where the altar stone fulfills 'an altar to the Lord in the midst of the land of Egypt' (Isa 19:19)." },
        { step: 15, group: "HOLY_FAMILY_AFRICA", bookId: "MAT", from: "Muharraq", to: "Nazareth", waypoints: ["Muharraq", "Memphis", "Gaza", "Nazareth"],
          title: "'Out of Egypt I Called My Son': Return from Upper Egypt to Nazareth",
          summary: "After the angel appears at Mount Qusqam announcing Herod's death (Mat 2:19–23; Hos 11:1), the Holy Family journeys back down the Nile through Western Assiut (Drunka) and Cairo to settle in Nazareth of Galilee." },
        { step: 16, group: "HOLY_FAMILY_AFRICA", bookId: "WIS", from: "Jerusalem", to: "Alexandria", waypoints: ["Jerusalem", "Alexandria", "Cyrene"],
          title: "Alexandria & Cyrene: Septuagint, Wisdom of Solomon, Sirach & 2 Maccabees",
          summary: "Alexandria becomes the intellectual hub where the Hebrew Scriptures are translated into Greek (LXX), Ben Sira's grandson translates Sirach (132 BCE), Wisdom of Solomon is composed, and Jason of Cyrene chronicles Maccabean history." },
        { step: 17, group: "HOLY_FAMILY_AFRICA", bookId: "PS151", from: "Jerusalem", to: "Qumran", waypoints: ["Jerusalem", "Jericho", "Qumran"],
          title: "Qumran Caves by the Dead Sea: Isaiah Scroll, Enoch, Jubilees & Psalm 151",
          summary: "In the limestone caves of Qumran, scribes preserve over 900 manuscripts including every Hebrew Bible book (except Esther), Aramaic 1 Enoch, Hebrew Jubilees, Tobit, Sirach, and Psalm 151." },
        { step: 18, group: "HOLY_FAMILY_AFRICA", bookId: "GTH", from: "Alexandria", to: "NagHammadi", waypoints: ["Alexandria", "Oxyrhynchus", "NagHammadi"],
          title: "Upper Egyptian Papyri: Oxyrhynchus & Nag Hammadi Codices",
          summary: "Along the Nile corridor at Oxyrhynchus (Al-Bahnasa) and the cliffs of Nag Hammadi (Chenoboskion), early Christian Greek papyri and leather-bound Coptic codices (including the Gospel of Thomas) are preserved in dry sands." },
        { step: 19, group: "HOLY_FAMILY_AFRICA", bookId: "1EN", from: "CaesareaPhilippi", to: "Aksum", waypoints: ["CaesareaPhilippi", "Qumran", "Syene", "Meroe", "Aksum"],
          title: "From Mount Hermon & Qumran to Aksum: 1 Enoch & Jubilees in Ge'ez",
          summary: "While Aramaic and Hebrew copies of 1 Enoch and Jubilees fragment in Judea, complete texts travel down the Nile and Red Sea corridor to the Kingdom of Aksum, preserved intact in liturgical Ge'ez within the 81-book Ethiopian Tewahedo canon." },
        { step: 20, group: "HOLY_FAMILY_AFRICA", bookId: "MEK", from: "Jerusalem", to: "Aksum", waypoints: ["Jerusalem", "Gaza", "Syene", "Meroe", "Aksum"],
          title: "Nile-to-Highlands Corridor: Cush, Meroë & Aksumite Zion",
          summary: "Connecting Isaiah 18, Zephaniah 3:10, the Ethiopian Eunuch of Acts 8, and Frumentius (Abba Salama), Aksum becomes a pillar of African biblical preservation (St. Mary of Zion, Garima Gospels, Meqabyan)." },

        // --- LAYER 3: GOSPELS, GALILEE, SAMARIA & JERUSALEM PASSION (Steps 21–27) ---
        { step: 21, group: "GOSPELS_GALILEE", bookId: "LUK", from: "Nazareth", to: "Bethlehem", waypoints: ["Nazareth", "Shechem", "Jerusalem", "Bethlehem"],
